# Copied to /etc/openestate/openestate.env by install-native.sh, with every
# "changeme" value replaced by a cryptographically random one (openssl rand).
# Mode 600, owned by root:openestate — this file holds live secrets.
# Never commit a real copy of this file anywhere.

# --- Database ---
# install-native.sh / setup-database.sh point these at whatever PostgreSQL
# the admin already runs (local or remote) — this project never installs or
# manages Postgres itself. Tenant-scoped connection (openestate_app role,
# RLS enforced by Postgres row-level security).
DATABASE_URL=postgresql://openestate_app:changeme@localhost:5432/openestate
# System connection (openestate_system role, BYPASSRLS, non-superuser).
# The real Postgres superuser is reserved for migrations only, run
# separately by setup-database.sh / upgrade-native.sh — never as a
# runtime app credential.
DATABASE_URL_SYSTEM=postgresql://openestate_system:changeme@localhost:5432/openestate

# --- Redis ---
# Also admin-managed — install-native.sh never installs redis-server.
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
SWAGGER_ENABLED=false
# Comma-separated origins allowed to call the API with credentials. An empty
# list disables CORS entirely (not "allow all") — set this to your real
# domain(s), e.g. https://crm.example.com
CORS_ALLOWLIST=http://localhost

# --- Local file storage ---
# Where uploaded layout plans/brochures/photos/documents are written.
# Must be writable by the openestate system user. install-native.sh creates
# this directory and chowns it; there is no S3/MinIO support in the
# application today, only local disk.
UPLOADS_DIR=/var/lib/openestate/uploads

# --- JWT ---
# Random strings, no fixed length requirement — generated as 48 characters
# by install-native.sh. Keep them secret; rotating either one invalidates
# every existing session of that kind (access or refresh) on next verify.
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Portal (customer/broker) refresh sessions are shorter-lived than staff's.
PORTAL_JWT_REFRESH_EXPIRES_IN=24h

# --- Encryption keys (AES-256-GCM) ---
# MUST be exactly 64 hex characters (32 bytes) — the app validates this
# exact length at startup and refuses to boot otherwise. Generate with:
#   openssl rand -hex 32
# Encrypts PAN numbers on Broker/Applicant records.
PAN_ENCRYPTION_KEY=changeme
# Encrypts TOTP 2FA secrets. Deliberately a separate key from PAN's — if one
# is rotated/compromised, the other is unaffected.
TOTP_ENCRYPTION_KEY=changeme
# One or more "version:hexkey" pairs, comma-separated, each hexkey exactly
# 64 hex characters (32 bytes). The highest version number encrypts new
# plugin/webhook secrets; older versions stay listed only so existing rows
# keep decrypting until rotated (see apps/api/scripts/rotate-plugin-secrets.ts).
# Example with two active versions: "1:aaaa...,2:bbbb..."
PLUGIN_SECRET_ENCRYPTION_KEYS=1:changeme
