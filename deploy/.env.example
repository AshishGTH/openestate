# Copied to deploy/.env by install.sh, with secrets replaced by
# cryptographically random values (openssl rand). Never commit deploy/.env.

# --- Postgres ---
POSTGRES_USER=openestate
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openestate
POSTGRES_PORT=5432
# Password for the openestate_app role (non-superuser, RLS enforced)
POSTGRES_APP_PASSWORD=changeme
# Password for the openestate_system role (BYPASSRLS, non-superuser)
POSTGRES_SYSTEM_PASSWORD=changeme

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=3000
NODE_ENV=production
LOG_LEVEL=info
SWAGGER_ENABLED=false
CORS_ALLOWLIST=http://localhost:8080
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORTAL_JWT_REFRESH_EXPIRES_IN=24h
PAN_ENCRYPTION_KEY=changeme
TOTP_ENCRYPTION_KEY=changeme
# version:hexkey pair(s), comma-separated — see PluginSecretEncryptionService
PLUGIN_SECRET_ENCRYPTION_KEYS=1:changeme

# --- Frontends (baked in at build time) ---
# Left empty: nginx's /api/ location already forwards the /api/ prefix
# through unchanged, and the frontend code appends /api/v1/... itself
# (see apps/web/src/lib/api.ts). Setting this to /api would double it,
# producing /api/api/v1/... and a "Cannot POST" error on every request.
VITE_API_URL=

# --- Reverse proxy ---
NGINX_PORT=8080

# --- MinIO (optional profile: `docker compose --profile storage up`) ---
MINIO_ROOT_USER=openestate
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
