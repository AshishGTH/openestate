{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL_TEST",
        "DATABASE_URL_TEST_SYSTEM",
        "REDIS_TEST_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
