NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Tenant-scoped connection (openestate_app role, RLS enforced).
# For local dev without RLS, point this at the same superuser.
DATABASE_URL=postgresql://openestate_app:openestate@localhost:5432/openestate
# System connection (openestate_system role, BYPASSRLS, non-superuser).
# Superuser is reserved for migrations only, never in app connection strings.
DATABASE_URL_SYSTEM=postgresql://openestate_system:openestate@localhost:5432/openestate
REDIS_URL=redis://localhost:6379

CORS_ALLOWLIST=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true

# --- Rate limiting (@nestjs/throttler, Redis-backed) ---
# Default bucket: all routes, IP-keyed, per 60s.
DEFAULT_THROTTLE_LIMIT=100
# Portal login/invite/password-reset bucket: IP-keyed, per 5 minutes.
# Deliberately tight — it is the brute-force guard on the portal's own
# unauthenticated endpoints. Raise it only if you genuinely have many
# portal users behind one shared public IP.
PORTAL_AUTH_THROTTLE_LIMIT=5

JWT_ACCESS_SECRET=changeme-generated-by-install-sh
JWT_REFRESH_SECRET=changeme-generated-by-install-sh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Portal (customer/broker) refresh sessions are shorter-lived than staff's.
PORTAL_JWT_REFRESH_EXPIRES_IN=24h

PAN_ENCRYPTION_KEY=changeme-32-byte-key-generated-by-install-sh
TOTP_ENCRYPTION_KEY=changeme-32-byte-key-generated-by-install-sh
# Plugin/webhook secret encryption (Phase 7) — one or more "version:hexkey"
# pairs, comma-separated. The highest version encrypts new secrets; older
# versions stay listed so existing rows keep decrypting until rotated
# (see apps/api/scripts/rotate-plugin-secrets.ts).
PLUGIN_SECRET_ENCRYPTION_KEYS=1:changeme-32-byte-key-generated-by-install-sh
