enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationStatus {
  QUEUED
  SENT
  FAILED
}

/// Append-only send ledger. applicantId is NEVER reassigned on applicant
/// merge — it always identifies the original recipient of the message,
/// even if that applicant is later merged into a survivor (see CLAUDE.md
/// Phase 3 decisions).
model CommunicationLog {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  inquiryId         String?              @map("inquiry_id") @db.Uuid
  applicantId       String               @map("applicant_id") @db.Uuid
  channel           CommunicationChannel
  toAddress         String               @map("to_address") @db.VarChar(255)
  subject           String?              @db.VarChar(500)
  body              String               @db.Text
  status            CommunicationStatus  @default(QUEUED)
  providerMessageId String?              @map("provider_message_id") @db.VarChar(255)
  errorMessage      String?              @map("error_message") @db.Text
  sentAt            DateTime?            @map("sent_at")
  createdById       String?              @map("created_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  inquiry   Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  applicant Applicant @relation(fields: [applicantId], references: [id])
  createdBy User?     @relation("commLogCreator", fields: [createdById], references: [id])

  @@index([companyId, applicantId, createdAt])
  @@map("communication_logs")
}

// ─── Phase 4: Financial core — bookings, ledger, receipts ─────
//
// Relation policy for Phase 4: the core financial graph (Booking, Installment,
// LedgerEntry, Receipt, …) uses full Prisma relations. Master/config FKs
// (chargeTypeId, gstRateId, bankId, receiptTypeId, interestRuleId,
// transferFeeRuleId, cancellationRuleId, paymentPlanTemplateId, documentTypeId)
// and user FKs (createdById, approvedById, verifiedById, uploadedById) are
// plain @db.Uuid scalars WITHOUT Prisma relations — their FK constraints are
// added at the DB level in the migration. This keeps User and the master
// models from accumulating dozens of back-relations while preserving
// referential integrity in Postgres.

enum AddressType {
  OFFICE
  PERMANENT
  PRESENT
}

model ApplicantAddress {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  applicantId String      @map("applicant_id") @db.Uuid
  addressType AddressType @map("address_type")
  line1       String      @db.VarChar(255)
  line2       String?     @db.VarChar(255)
  city        String?     @db.VarChar(100)
  state       String?     @db.VarChar(100)
  stateCode   String?     @map("state_code") @db.VarChar(2)
  pincode     String?     @db.VarChar(10)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([applicantId, addressType])
  @@map("applicant_addresses")
}

model ApplicantDocument {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  applicantId    String   @map("applicant_id") @db.Uuid
  documentTypeId String?  @map("document_type_id") @db.Uuid
  storedName     String   @map("stored_name") @db.VarChar(255)
  originalName   String   @map("original_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  sizeBytes      Int      @map("size_bytes")
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([companyId, applicantId])
  @@map("applicant_documents")
}

model CancellationRule {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  name                 String   @db.VarChar(255)
  deductionType        String   @map("deduction_type") @db.VarChar(20) // PERCENT | FLAT
  deductionPercent     Decimal? @map("deduction_percent") @db.Decimal(5, 2)
  deductionAmountPaise BigInt?  @map("deduction_amount_paise")
  forfeitBookingAmount Boolean  @default(false) @map("forfeit_booking_amount")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  company              Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("cancellation_rules")
}

enum BookingStatus {
  APPLICATION
  BOOKED
  ALLOTTED
  REGISTERED
  CANCELLED
  SURRENDERED
  TRANSFERRED_OUT
}

model Booking {
  id                     String        @id @default(uuid()) @db.Uuid
  companyId              String        @map("company_id") @db.Uuid
  unitId                 String        @map("unit_id") @db.Uuid
  primaryApplicantId     String        @map("primary_applicant_id") @db.Uuid
  bookingNumber          String        @map("booking_number") @db.VarChar(40)
  status                 BookingStatus @default(APPLICATION)
  agreedPricePaise       BigInt        @map("agreed_price_paise")
  // Snapshot of the GST place-of-supply state code, taken at booking and
  // immutable thereafter. Per IGST Act §12(3)(a), the place of supply of
  // services directly in relation to immovable property is the LOCATION OF
  // THE PROPERTY — not the customer's residential state. Defaulted from the
  // project/area-location state at creation, overridable then, frozen after.
  // Do not "fix" this to follow the applicant's address.
  placeOfSupplyStateCode String?       @map("place_of_supply_state_code") @db.VarChar(2)
  paymentPlanTemplateId  String?       @map("payment_plan_template_id") @db.Uuid
  // Interest rule for overdue installments (Phase 4). Null = no delay interest.
  // Scalar + DB-level FK (no Prisma relation).
  interestRuleId         String?       @map("interest_rule_id") @db.Uuid
  // Sourcing broker (Phase 5). Null = unsourced booking, no commission/NOC
  // gating at all. Scalar + DB-level FK (no Prisma relation), same policy
  // as interestRuleId above — set by a Phase 5 controller-layer call after
  // the booking exists, never by BookingService itself.
  brokerId               String?       @map("broker_id") @db.Uuid
  bookingDate            DateTime      @map("booking_date") @db.Date
  allotmentDate          DateTime?     @map("allotment_date") @db.Date
  registrationDate       DateTime?     @map("registration_date") @db.Date
  cancelledAt            DateTime?     @map("cancelled_at")
  createdById            String?       @map("created_by_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  company            Company              @relation(fields: [companyId], references: [id])
  unit               Unit                 @relation(fields: [unitId], references: [id])
  primaryApplicant   Applicant            @relation("bookingPrimaryApplicant", fields: [primaryApplicantId], references: [id])
  coApplicants       BookingCoApplicant[]
  costLines          BookingCostLine[]
  paymentPlans       PaymentPlan[]
  installments       Installment[]
  ledgerEntries      LedgerEntry[]
  receipts           Receipt[]
  transfersFrom      Transfer[]           @relation("transferFrom")
  transfersTo        Transfer[]           @relation("transferTo")
  cancellations      Cancellation[]
  refunds            Refund[]
  paymentVouchers    PaymentVoucher[]
  extraCharges       ExtraCharge[]
  tdsDeductions      TdsDeduction[]
  interestAccruals   InterestAccrual[]
  generatedDocuments GeneratedDocument[]
  documentDispatches DocumentDispatch[]

  @@unique([companyId, bookingNumber])
  @@index([companyId, status])
  @@index([companyId, unitId])
  @@map("bookings")
}

model BookingCoApplicant {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  ordinal     Int      @default(2)
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  applicant Applicant @relation(fields: [applicantId], references: [id])

  @@unique([bookingId, applicantId])
  @@map("booking_co_applicants")
}

enum CostLineKind {
  BASE
  PLC
  PARKING
  CLUB
  MAINTENANCE
  OTHER
}

/// Snapshot of a booking's agreed cost breakup, taken at booking time.
/// The GST rate is captured here (gstRatePercentSnapshot) and immutable —
/// re-pricing the charge master later never changes an existing booking.
model BookingCostLine {
  id                     String       @id @default(uuid()) @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  bookingId              String       @map("booking_id") @db.Uuid
  kind                   CostLineKind
  chargeTypeId           String?      @map("charge_type_id") @db.Uuid
  label                  String       @db.VarChar(255)
  baseAmountPaise        BigInt       @map("base_amount_paise")
  gstRateId              String?      @map("gst_rate_id") @db.Uuid
  gstRatePercentSnapshot Decimal      @default(0) @map("gst_rate_percent_snapshot") @db.Decimal(5, 2)
  cgstPaise              BigInt       @default(0) @map("cgst_paise")
  sgstPaise              BigInt       @default(0) @map("sgst_paise")
  igstPaise              BigInt       @default(0) @map("igst_paise")
  lineTotalPaise         BigInt       @map("line_total_paise")
  sortOrder              Int          @default(0) @map("sort_order")
  createdAt              DateTime     @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingId])
  @@map("booking_cost_lines")
}

model PaymentPlan {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid
  name        String   @db.VarChar(255)
  isCustom    Boolean  @default(false) @map("is_custom")
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([companyId, bookingId])
  @@map("payment_plans")
}

enum InstallmentStatus {
  UNPAID
  PART_PAID
  PAID
}

/// An installment is FROZEN (immutable, may not be edited or regenerated)
/// exactly when allocatedPaise > 0. There is no separate isFrozen column —
/// allocatedPaise (a maintained cache of Σ ReceiptAllocation) is the single
/// source of truth for the freeze rule (see CLAUDE.md Phase 4 decisions).
model Installment {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  bookingId        String            @map("booking_id") @db.Uuid
  planId           String            @map("plan_id") @db.Uuid
  seq              Int
  label            String            @db.VarChar(255)
  dueDate          DateTime          @map("due_date") @db.Date
  amountPaise      BigInt            @map("amount_paise")
  milestonePercent Decimal?          @map("milestone_percent") @db.Decimal(6, 3)
  allocatedPaise   BigInt            @default(0) @map("allocated_paise")
  status           InstallmentStatus @default(UNPAID)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  plan        PaymentPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  allocations ReceiptAllocation[]

  @@index([companyId, bookingId])
  @@index([companyId, dueDate])
  @@map("installments")
}

enum LedgerEntryType {
  CHARGE
  EXTRA_CHARGE
  RECEIPT_ALLOC
  INTEREST
  INTEREST_WAIVER
  BOUNCE_REVERSAL
  BOUNCE_CHARGE
  REFUND_APPROVED
  REFUND_BOUNCE_REVERSAL
  TRANSFER_CARRY_OUT
  TRANSFER_CARRY_IN
  TRANSFER_FEE
  CANCELLATION_SETTLEMENT
  CANCELLATION_DEDUCTION
  TDS_RECEIVABLE
  TDS_CERT_ADJUSTMENT
  ADJUSTMENT
}

/// APPEND-ONLY. The booking balance is DEFINED as SUM(signed_amount_paise).
/// Positive = debit (customer owes); negative = credit (customer paid/credited).
/// Corrections are new negating rows referencing reversalOfEntryId — never an
/// UPDATE or DELETE. A DB trigger forbids UPDATE/DELETE on this table.
model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  bookingId         String          @map("booking_id") @db.Uuid
  entryType         LedgerEntryType @map("entry_type")
  signedAmountPaise BigInt          @map("signed_amount_paise")
  installmentId     String?         @map("installment_id") @db.Uuid
  receiptId         String?         @map("receipt_id") @db.Uuid
  reversalOfEntryId String?         @map("reversal_of_entry_id") @db.Uuid
  reason            String?         @db.VarChar(500)
  effectiveDate     DateTime        @map("effective_date") @db.Date
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  company    Company       @relation(fields: [companyId], references: [id])
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  receipt    Receipt?      @relation(fields: [receiptId], references: [id])
  reversalOf LedgerEntry?  @relation("ledgerReversal", fields: [reversalOfEntryId], references: [id])
  reversedBy LedgerEntry[] @relation("ledgerReversal")

  @@index([companyId, bookingId])
  @@index([companyId, entryType])
  @@map("ledger_entries")
}

enum ReceiptMode {
  CASH
  CHEQUE
  DD
  NEFT
  RTGS
  UPI
  CARD
}

enum ChequeClearanceStatus {
  NOT_APPLICABLE
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
}

model Receipt {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @map("company_id") @db.Uuid
  bookingId        String                @map("booking_id") @db.Uuid
  receiptNumber    String                @map("receipt_number") @db.VarChar(40)
  fyLabel          String                @map("fy_label") @db.VarChar(9)
  seqValue         Int                   @map("seq_value")
  receiptDate      DateTime              @map("receipt_date") @db.Date
  mode             ReceiptMode
  grossAmountPaise BigInt                @map("gross_amount_paise")
  receiptTypeId    String?               @map("receipt_type_id") @db.Uuid
  bankId           String?               @map("bank_id") @db.Uuid
  instrumentNumber String?               @map("instrument_number") @db.VarChar(50)
  instrumentDate   DateTime?             @map("instrument_date") @db.Date
  utr              String?               @db.VarChar(50)
  clearanceStatus  ChequeClearanceStatus @default(NOT_APPLICABLE) @map("clearance_status")
  isReversed       Boolean               @default(false) @map("is_reversed")
  reversalReason   String?               @map("reversal_reason") @db.VarChar(500)
  reprintCount     Int                   @default(0) @map("reprint_count")
  createdById      String?               @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id])
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  allocations   ReceiptAllocation[]
  chequeEvents  ChequeStatusEvent[]
  ledgerEntries LedgerEntry[]
  tdsDeductions TdsDeduction[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, bookingId])
  @@map("receipts")
}

/// APPEND-ONLY. Which installment(s) a receipt settled. Σ allocations ==
/// receipt gross. A DB trigger forbids UPDATE/DELETE.
model ReceiptAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  receiptId     String   @map("receipt_id") @db.Uuid
  installmentId String   @map("installment_id") @db.Uuid
  amountPaise   BigInt   @map("amount_paise")
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company     @relation(fields: [companyId], references: [id])
  receipt     Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id])

  @@index([companyId, installmentId])
  @@map("receipt_allocations")
}

/// APPEND-ONLY cheque lifecycle log. The cached Receipt.clearanceStatus is
/// derived from the latest event. A DB trigger forbids UPDATE/DELETE.
model ChequeStatusEvent {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String                @map("company_id") @db.Uuid
  receiptId   String                @map("receipt_id") @db.Uuid
  status      ChequeClearanceStatus
  eventDate   DateTime              @map("event_date") @db.Date
  reason      String?               @db.VarChar(500)
  createdById String?               @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([companyId, receiptId, createdAt])
  @@map("cheque_status_events")
}

/// Gap-free document-number allocator. Incremented inside the same
/// transaction as the row it numbers (e.g. a receipt); a rolled-back
/// transaction releases its number, so committed rows are strictly
/// contiguous per (company, kind, scope). Not append-only — it is a counter.
model NumberSequence {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  kind       String   @db.VarChar(30) // RECEIPT | BOOKING | …
  scopeLabel String   @map("scope_label") @db.VarChar(20) // FY label, or GLOBAL
  nextValue  Int      @default(1) @map("next_value")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, kind, scopeLabel])
  @@map("number_sequences")
}

enum TransferType {
  UNIT
  APPLICANT
}

model Transfer {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  fromBookingId     String       @map("from_booking_id") @db.Uuid
  toBookingId       String?      @map("to_booking_id") @db.Uuid
  transferType      TransferType @map("transfer_type")
  transferFeeRuleId String?      @map("transfer_fee_rule_id") @db.Uuid
  transferFeePaise  BigInt       @default(0) @map("transfer_fee_paise")
  carryForwardPaise BigInt       @map("carry_forward_paise")
  reason            String?      @db.VarChar(500)
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")

  company     Company  @relation(fields: [companyId], references: [id])
  fromBooking Booking  @relation("transferFrom", fields: [fromBookingId], references: [id])
  toBooking   Booking? @relation("transferTo", fields: [toBookingId], references: [id])

  @@index([companyId, fromBookingId])
  @@map("transfers")
}

enum CancellationType {
  CANCEL
  SURRENDER
}

model Cancellation {
  id                    String           @id @default(uuid()) @db.Uuid
  companyId             String           @map("company_id") @db.Uuid
  bookingId             String           @map("booking_id") @db.Uuid
  cancellationType      CancellationType @map("cancellation_type")
  cancellationRuleId    String?          @map("cancellation_rule_id") @db.Uuid
  deductionTypeSnapshot String           @map("deduction_type_snapshot") @db.VarChar(20)
  deductionPaise        BigInt           @map("deduction_paise")
  refundablePaise       BigInt           @map("refundable_paise")
  reason                String?          @db.VarChar(500)
  createdById           String?          @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")

  company Company  @relation(fields: [companyId], references: [id])
  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([companyId, bookingId])
  @@map("cancellations")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  bookingId      String       @map("booking_id") @db.Uuid
  cancellationId String?      @map("cancellation_id") @db.Uuid
  amountPaise    BigInt       @map("amount_paise")
  status         RefundStatus @default(REQUESTED)
  mode           ReceiptMode?
  approvedById   String?      @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?    @map("approved_at")
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  company      Company          @relation(fields: [companyId], references: [id])
  booking      Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cancellation Cancellation?    @relation(fields: [cancellationId], references: [id])
  vouchers     PaymentVoucher[]

  @@index([companyId, bookingId])
  @@map("refunds")
}

enum VoucherStatus {
  ISSUED
  CLEARED
  BOUNCED
}

/// Records actual cash/bank OUTFLOW (e.g. a refund payout). Separate from the
/// customer sub-ledger: the ledger recognises the refund OBLIGATION at
/// approval (REFUND_APPROVED debit); this voucher records the SETTLEMENT at
/// payment. A bounced refund cheque re-opens the obligation via a
/// REFUND_BOUNCE_REVERSAL ledger entry. See CLAUDE.md Phase 4 decisions.
model PaymentVoucher {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  bookingId        String        @map("booking_id") @db.Uuid
  refundId         String?       @map("refund_id") @db.Uuid
  amountPaise      BigInt        @map("amount_paise")
  mode             ReceiptMode
  bankId           String?       @map("bank_id") @db.Uuid
  instrumentNumber String?       @map("instrument_number") @db.VarChar(50)
  instrumentDate   DateTime?     @map("instrument_date") @db.Date
  status           VoucherStatus @default(ISSUED)
  createdById      String?       @map("created_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refund  Refund? @relation(fields: [refundId], references: [id])

  @@index([companyId, bookingId])
  @@map("payment_vouchers")
}

/// Off-schedule charge added to a booking after the fact. GST rate captured
/// at entry-time from the linked ChargeType's current effective GST rate and
/// immutable after — same discipline as BookingCostLine.
model ExtraCharge {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  bookingId              String   @map("booking_id") @db.Uuid
  chargeTypeId           String?  @map("charge_type_id") @db.Uuid
  label                  String   @db.VarChar(255)
  baseAmountPaise        BigInt   @map("base_amount_paise")
  gstRateId              String?  @map("gst_rate_id") @db.Uuid
  gstRatePercentSnapshot Decimal  @default(0) @map("gst_rate_percent_snapshot") @db.Decimal(5, 2)
  cgstPaise              BigInt   @default(0) @map("cgst_paise")
  sgstPaise              BigInt   @default(0) @map("sgst_paise")
  igstPaise              BigInt   @default(0) @map("igst_paise")
  lineTotalPaise         BigInt   @map("line_total_paise")
  createdById            String?  @map("created_by_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingId])
  @@map("extra_charges")
}

/// APPEND-ONLY. TDS (194-IA) withheld on a receipt. The TDS_RECEIVABLE ledger
/// debit keeps the withheld amount visible as outstanding until a certificate
/// is recorded. Certificate receipt is a separate append-only TdsCertificate
/// row (not a mutable flag). A DB trigger forbids UPDATE/DELETE.
model TdsDeduction {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  bookingId               String   @map("booking_id") @db.Uuid
  receiptId               String?  @map("receipt_id") @db.Uuid
  sectionSnapshot         String   @map("section_snapshot") @db.VarChar(20)
  ratePercentSnapshot     Decimal  @map("rate_percent_snapshot") @db.Decimal(5, 2)
  deductedPaise           BigInt   @map("deducted_paise")
  receivableLedgerEntryId String?  @map("receivable_ledger_entry_id") @db.Uuid
  createdById             String?  @map("created_by_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")

  company     Company         @relation(fields: [companyId], references: [id])
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  receipt     Receipt?        @relation(fields: [receiptId], references: [id])
  certificate TdsCertificate?

  @@index([companyId, bookingId])
  @@map("tds_deductions")
}

/// APPEND-ONLY. Recording a TDS certificate posts the TDS_CERT_ADJUSTMENT
/// credit that zeroes the corresponding TDS receivable. One per deduction.
/// A DB trigger forbids UPDATE/DELETE.
model TdsCertificate {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  tdsDeductionId          String   @unique @map("tds_deduction_id") @db.Uuid
  certificateNumber       String   @map("certificate_number") @db.VarChar(50)
  certificateDate         DateTime @map("certificate_date") @db.Date
  adjustmentLedgerEntryId String?  @map("adjustment_ledger_entry_id") @db.Uuid
  createdById             String?  @map("created_by_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")

  company      Company      @relation(fields: [companyId], references: [id])
  tdsDeduction TdsDeduction @relation(fields: [tdsDeductionId], references: [id], onDelete: Cascade)

  @@map("tds_certificates")
}

/// APPEND-ONLY. One row per accrual period per installment, with a periodEnd
/// cursor for idempotency (re-running the daily job never double-posts). The
/// posted INTEREST debit is referenced by ledgerEntryId. A DB trigger forbids
/// UPDATE/DELETE.
model InterestAccrual {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  bookingId           String   @map("booking_id") @db.Uuid
  installmentId       String?  @map("installment_id") @db.Uuid
  interestRuleId      String?  @map("interest_rule_id") @db.Uuid
  rateType            String   @map("rate_type") @db.VarChar(20)
  ratePercentSnapshot Decimal  @map("rate_percent_snapshot") @db.Decimal(5, 2)
  periodStart         DateTime @map("period_start") @db.Date
  periodEnd           DateTime @map("period_end") @db.Date
  principalPaise      BigInt   @map("principal_paise")
  accruedPaise        BigInt   @map("accrued_paise")
  ledgerEntryId       String?  @map("ledger_entry_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingId])
  @@index([companyId, installmentId, periodEnd])
  @@map("interest_accruals")
}

// ─── Phase 4 UI layer: generated documents, dispatch, booking drafts ──
//
// These are consumers of the ledger core, not part of it — no DB append-only
// triggers here (unlike ledger_entries etc.); immutability of generated PDFs
// and dispatch attempts is enforced at the service layer (no update methods).

enum GeneratedDocumentType {
  STATEMENT
  RECEIPT
  ALLOTMENT_LETTER
  DEMAND_LETTER
  REMINDER_LETTER
  BROKER_STATEMENT
}

/// A generated PDF artifact. Stored via the Phase 2 UploadService (uuid+ext,
/// magic-byte validated) and never regenerated on read — the same booking's
/// statement viewed twice returns the SAME stored bytes. A reprint (e.g. of a
/// receipt) creates a NEW row with isDuplicate=true and sourceDocumentId
/// pointing at the original; it does not overwrite or regenerate the original.
model GeneratedDocument {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @map("company_id") @db.Uuid
  bookingId        String?               @map("booking_id") @db.Uuid
  applicantId      String?               @map("applicant_id") @db.Uuid
  // Which receipt this PDF represents, for documentType=RECEIPT (a booking has
  // many receipts, so bookingId alone can't identify one). Scalar + DB-level
  // FK, no Prisma relation — same policy as the Phase 4 ledger core.
  receiptId        String?               @map("receipt_id") @db.Uuid
  // For documentType=BROKER_STATEMENT (Phase 5 commit 3). Added in a
  // separate forward-only migration after the Phase 5 schema migration —
  // GeneratedDocument is unfrozen Phase 4-UI, so a real Prisma relation
  // (not scalar-only) matches booking/applicant's existing shape here.
  brokerId         String?               @map("broker_id") @db.Uuid
  documentType     GeneratedDocumentType @map("document_type")
  templateId       String?               @map("template_id") @db.Uuid
  storedName       String                @map("stored_name") @db.VarChar(255)
  originalName     String                @map("original_name") @db.VarChar(255)
  mimeType         String                @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                   @map("size_bytes")
  isDuplicate      Boolean               @default(false) @map("is_duplicate")
  sourceDocumentId String?               @map("source_document_id") @db.Uuid
  createdById      String?               @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")

  company        Company             @relation(fields: [companyId], references: [id])
  booking        Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  applicant      Applicant?          @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  broker         Broker?             @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  sourceDocument GeneratedDocument?  @relation("documentReprint", fields: [sourceDocumentId], references: [id])
  reprints       GeneratedDocument[] @relation("documentReprint")
  dispatches     DocumentDispatch[]

  @@index([companyId, bookingId])
  @@index([companyId, applicantId])
  @@index([companyId, brokerId])
  @@map("generated_documents")
}

enum DispatchChannel {
  EMAIL
  SMS
}

enum DispatchStatus {
  QUEUED
  SENT
  FAILED
}

/// One row per SEND ATTEMPT, immutable once created (service layer never
/// updates a row after creation except the status transition performed by the
/// dispatch processor). A failed send is retried by creating a NEW row with
/// attemptOfDispatchId pointing at the original — never by mutating the
/// failed row — preserving a full attempt history per document.
model DocumentDispatch {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           String          @map("company_id") @db.Uuid
  generatedDocumentId String?         @map("generated_document_id") @db.Uuid
  bookingId           String?         @map("booking_id") @db.Uuid
  applicantId         String?         @map("applicant_id") @db.Uuid
  recipientAddress    String          @map("recipient_address") @db.VarChar(255)
  channel             DispatchChannel
  templateSnapshot    String          @map("template_snapshot") @db.Text
  status              DispatchStatus  @default(QUEUED)
  providerMessageId   String?         @map("provider_message_id") @db.VarChar(255)
  errorMessage        String?         @map("error_message") @db.Text
  attemptOfDispatchId String?         @map("attempt_of_dispatch_id") @db.Uuid
  createdById         String?         @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id])
  generatedDocument GeneratedDocument? @relation(fields: [generatedDocumentId], references: [id])
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  applicant         Applicant?         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  attemptOf         DocumentDispatch?  @relation("dispatchRetry", fields: [attemptOfDispatchId], references: [id])
  retries           DocumentDispatch[] @relation("dispatchRetry")

  @@index([companyId, bookingId])
  @@index([companyId, applicantId])
  @@map("document_dispatches")
}

/// Persisted wizard state so a partially-filled booking form can be resumed
/// (e.g. the next day) rather than lost. Freeform JSON keyed by wizard step;
/// never itself posts to the ledger — only BookingService.createBooking does.
model BookingDraft {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  label       String?  @db.VarChar(255)
  draftData   Json     @map("draft_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdById])
  @@map("booking_drafts")
}

// ─── Phase 5: brokers and commissions ──────────────────────────

model Broker {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String    @db.VarChar(255)
  phone         String    @db.VarChar(20)
  email         String?   @db.VarChar(255)
  reraAgentNo   String?   @map("rera_agent_no") @db.VarChar(50)
  // PAN encrypted at rest via the new PanEncryptionService (AES-256-GCM,
  // PAN_ENCRYPTION_KEY) — same shape as Applicant's dormant PAN columns
  // (Phase 4), but Applicant's are still unused; see docs/todo.md.
  panCiphertext String?   @map("pan_ciphertext") @db.Text
  panMasked     String?   @map("pan_masked") @db.VarChar(15)
  panKeyVersion Int       @default(1) @map("pan_key_version") @db.SmallInt
  isActive      Boolean   @default(true) @map("is_active")
  // Non-null only while inactive. Consumed by NocService's auto-approval
  // path (Phase 5 §6) — an inactive broker's cancellations don't wait on
  // a human NOC.
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company            Company                   @relation(fields: [companyId], references: [id])
  bankDetails        BrokerBankDetail[]
  commissionRules    BrokerCommissionRule[]
  bookingCommissions BrokerBookingCommission[]
  ledgerEntries      CommissionLedgerEntry[]
  payments           CommissionPayment[]
  generatedDocuments GeneratedDocument[]

  @@unique([companyId, phone])
  @@map("brokers")
}

model BrokerBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  brokerId      String   @map("broker_id") @db.Uuid
  accountHolder String   @map("account_holder") @db.VarChar(255)
  accountNumber String   @map("account_number") @db.VarChar(30)
  ifsc          String   @db.VarChar(11)
  bankName      String   @map("bank_name") @db.VarChar(255)
  isPrimary     Boolean  @default(true) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  broker  Broker  @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([companyId, brokerId])
  @@map("broker_bank_details")
}

/// One rule per (company, broker, optional project override — null =
/// company-wide default for that broker). commissionType discriminates
/// which of the amount fields apply, same pattern as
/// CancellationRule.deductionType (plain string, not a Postgres enum,
/// since this is admin-configured rule shape, not a fixed ledger-write
/// set). Deliberately has NO effective-dating (unlike GstRate/TdsRule) —
/// edits apply immediately to future accruals only, because
/// BrokerBookingCommission (below) snapshots the computed total at first
/// accrual and never re-reads the rule after that; effective-dating would
/// solve a problem the snapshot already solves. Rules/slabs are edited in
/// place, mirroring PaymentPlanTemplate/PaymentPlanMilestone.
model BrokerCommissionRule {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  brokerId       String   @map("broker_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  commissionType String   @map("commission_type") @db.VarChar(20) // FLAT_PERCENT | FLAT_AMOUNT | SLAB
  flatPercent    Decimal? @map("flat_percent") @db.Decimal(5, 2)
  flatPaise      BigInt?  @map("flat_paise")
  // Collection-percent breakpoints for ON_COLLECTION_MILESTONE accrual
  // mode, e.g. [25, 50, 100]. Validated by a zod schema at save time
  // (monotonic ascending integers in (0, 100], no duplicates) — see
  // packages/shared/src/commission.ts.
  milestonesJson Json?    @map("milestones_json")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company                @relation(fields: [companyId], references: [id])
  broker  Broker                 @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  slabs   BrokerCommissionSlab[]

  @@index([companyId, brokerId, projectId])
  @@map("broker_commission_rules")
}

/// Half-open bracket [fromPaise, toPaise) — fromPaise inclusive, toPaise
/// exclusive, so a value landing exactly on a boundary always matches the
/// HIGHER bracket. toPaise = null means unbounded top (must be exactly
/// one such slab per rule, the one with the highest seq). Matched, not
/// marginal: the whole basis amount is charged at ONE matched slab's
/// rate, not split across brackets like income tax.
model BrokerCommissionSlab {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  ruleId      String  @map("rule_id") @db.Uuid
  seq         Int
  fromPaise   BigInt  @map("from_paise")
  toPaise     BigInt? @map("to_paise")
  ratePercent Decimal @map("rate_percent") @db.Decimal(5, 2)

  company Company              @relation(fields: [companyId], references: [id])
  rule    BrokerCommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, seq])
  @@map("broker_commission_slabs")
}

/// The commission basis for one booking, computed ONCE (against
/// agreedPricePaise and the applicable flat/slab rule) at the first
/// accrual call and never re-evaluated. Every subsequent
/// ON_COLLECTION_MILESTONE accrual for this booking partitions
/// totalCommissionPaise (via the shared `allocate` largest-remainder
/// helper) rather than recomputing against a possibly-since-edited rule —
/// this is what actually protects in-flight bookings from a later rule
/// edit (see BrokerCommissionRule's doc comment).
model BrokerBookingCommission {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  bookingId            String   @unique @map("booking_id") @db.Uuid
  brokerId             String   @map("broker_id") @db.Uuid
  ruleId               String   @map("rule_id") @db.Uuid // provenance only — never re-read for math
  totalCommissionPaise BigInt   @map("total_commission_paise")
  computedAt           DateTime @default(now()) @map("computed_at")

  company Company @relation(fields: [companyId], references: [id])
  broker  Broker  @relation(fields: [brokerId], references: [id])

  @@map("broker_booking_commissions")
}

enum CommissionEntryType {
  ACCRUAL
  TDS_WITHHELD
  PAYMENT
  CLAWBACK_REVERSAL
  CLAWBACK_RECOVERY
  CLAWBACK_WRITEOFF
}

/// Broker's own append-only sub-ledger — structurally identical to the
/// booking LedgerEntry (same forbid_financial_mutation trigger, same
/// app.allow_financial_mutation escape hatch) but keyed by brokerId.
/// broker.outstanding = SUM(signedAmountPaise): positive = company owes
/// the broker, negative = broker owes the company back (post-clawback).
/// bookingId is scalar-only (no Prisma relation), same "relation policy"
/// as the Phase 4 ledger core — it points at the frozen Booking table.
model CommissionLedgerEntry {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  brokerId          String              @map("broker_id") @db.Uuid
  bookingId         String              @map("booking_id") @db.Uuid
  entryType         CommissionEntryType @map("entry_type")
  signedAmountPaise BigInt              @map("signed_amount_paise")
  // Which milestone this accrual corresponds to (ON_COLLECTION_MILESTONE
  // mode only — null under ON_BOOKING mode or for non-ACCRUAL entries).
  // The idempotency check for milestone accrual is
  // WHERE bookingId=? AND milestonePercent=?, run inside the same
  // withTenantTx as the insert.
  milestonePercent  Int?                @map("milestone_percent")
  reversalOfEntryId String?             @map("reversal_of_entry_id") @db.Uuid
  reason            String?             @db.VarChar(500)
  effectiveDate     DateTime            @map("effective_date") @db.Date
  createdById       String?             @map("created_by_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  broker  Broker  @relation(fields: [brokerId], references: [id])

  @@index([companyId, brokerId])
  @@index([companyId, bookingId])
  @@map("commission_ledger_entries")
}

enum CommissionPaymentStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

/// REQUESTED → APPROVED → PAID | REJECTED, mirroring RefundStatus's shape
/// exactly. Ledger entries (PAYMENT, TDS_WITHHELD) post ONLY at pay() —
/// deliberately unlike RefundService (which posts at approve()), because
/// a refund's obligation is newly-recognized at approval while a broker's
/// commission was already accrued earlier; request/approve here are pure
/// dispute/authorization sign-off with no ledger effect. See
/// CommissionPaymentService.pay() for the full TDS-withholding-timing
/// rationale (194-H vs 194-IA asymmetry) and CLAUDE.md's Decisions log.
model CommissionPayment {
  id               String                  @id @default(uuid()) @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  brokerId         String                  @map("broker_id") @db.Uuid
  amountPaise      BigInt                  @map("amount_paise") // gross, pre-TDS
  status           CommissionPaymentStatus @default(REQUESTED)
  mode             ReceiptMode?
  bankId           String?                 @map("bank_id") @db.Uuid
  instrumentNumber String?                 @map("instrument_number") @db.VarChar(50)
  approvedById     String?                 @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?               @map("approved_at")
  paidAt           DateTime?               @map("paid_at")
  createdById      String?                 @map("created_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  broker  Broker  @relation(fields: [brokerId], references: [id])

  @@index([companyId, brokerId])
  @@map("commission_payments")
}

enum NocStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// Broker no-objection-certificate for a cancellation. Mirrors
/// RefundStatus's shape (schema.prisma, Refund model). bookingId is
/// scalar-only (no Prisma relation — points at the frozen Booking table,
/// same relation policy as CommissionLedgerEntry.bookingId).
/// reason = "broker_inactive_auto_approved" (approvedById null) marks the
/// auto-approval path for an inactive broker's sourced bookings.
model BrokerNoc {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  bookingId     String    @map("booking_id") @db.Uuid
  brokerId      String    @map("broker_id") @db.Uuid
  status        NocStatus @default(REQUESTED)
  reason        String?   @db.VarChar(500)
  requestedById String?   @map("requested_by_id") @db.Uuid
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, bookingId])
  @@map("broker_nocs")
}
