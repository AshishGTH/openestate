  cancellationRuleId    String?          @map("cancellation_rule_id") @db.Uuid
  deductionTypeSnapshot String           @map("deduction_type_snapshot") @db.VarChar(20)
  deductionPaise        BigInt           @map("deduction_paise")
  refundablePaise       BigInt           @map("refundable_paise")
  reason                String?          @db.VarChar(500)
  createdById           String?          @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")

  company Company  @relation(fields: [companyId], references: [id])
  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
