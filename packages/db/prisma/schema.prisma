  sortOrder   Int                    @default(0) @map("sort_order")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  company     Company                @relation(fields: [companyId], references: [id])
  milestones  PaymentPlanMilestone[]

  @@unique([companyId, name])
  @@map("payment_plan_templates")
}

/// Whether a milestone becomes due by calendar offset from booking date
/// (current, original behaviour) or only once a staff user marks the
/// underlying construction stage complete and raises it. See
/// docs/plans/construction-linked-demand-fix.md — this distinction is the
/// entire point of that fix: previously EVERY milestone behaved as
/// DATE_LINKED, which is what let a customer be shown overdue against a
/// construction stage the builder had never reached.
enum MilestoneType {
  DATE_LINKED
  STAGE_LINKED
}

/// A milestone line of a payment-plan template. Instantiated per booking into
/// an Installment: amount = percent% of agreed price (allocated with no
/// rounding loss).
///
/// DATE_LINKED: dueDate = bookingDate + dueOffsetDays (original behaviour,
/// dueOffsetDays keeps its exact original meaning).
/// STAGE_LINKED: dueDate = stageCompletedOn + graceDaysAfterRaise, set only
/// when a StageRaise happens for this milestone's (project, template, seq).
/// `dueOffsetDays` is not reused for this case — a field meaning two
/// different things depending on milestoneType is exactly the kind of
/// overload this codebase avoids for date/money-adjacent fields.
///
/// Milestone percents for a template should sum to 100.
model PaymentPlanMilestone {
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  templateId          String        @map("template_id") @db.Uuid
  seq                 Int
  label               String        @db.VarChar(255)
  percent             Decimal       @db.Decimal(6, 3)
  milestoneType       MilestoneType @default(DATE_LINKED) @map("milestone_type")
  dueOffsetDays       Int           @default(0) @map("due_offset_days")
  graceDaysAfterRaise Int           @default(0) @map("grace_days_after_raise")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  company  Company             @relation(fields: [companyId], references: [id])
  template PaymentPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, seq])
  @@map("payment_plan_milestones")
}

/// The audit-trail record for one "stage completed, raise its demands"
/// event. Exactly one row per raise action, whether it touched one
/// installment or hundreds — see docs/plans/construction-linked-demand-fix.md
/// §1.4. `templateId`/`milestoneSeq` identify the stage being raised
/// (a PaymentPlanMilestone is template-scoped, not project-scoped, so the
/// stage's true identity within one project is the pair (templateId,
/// milestoneSeq), not the milestone id alone — the same milestone
/// definition could in principle be reused by another project's booking,
/// and that must NOT be treated as the same physical stage).
model StageRaise {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  templateId       String   @map("template_id") @db.Uuid
  milestoneSeq     Int      @map("milestone_seq")
  label            String   @db.VarChar(255)
  stageCompletedOn DateTime @map("stage_completed_on") @db.Date
  raisedById       String?  @map("raised_by_id") @db.Uuid
  raisedAt         DateTime @default(now()) @map("raised_at")

  company      Company       @relation(fields: [companyId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id])
  installments Installment[]

  @@index([companyId, projectId, templateId, milestoneSeq])
  @@map("stage_raises")
}

// ─── Phase 2: Inventory ───────────────────────────────────────

enum UnitStatus {
  AVAILABLE
  HELD
  BLOCKED
  BOOKED
  ALLOTTED
  REGISTERED
  CANCELLED
}

/// The inventory hierarchy shape a Project uses. Two values, not six —
/// see docs/plans/plotted-farmhouse-inventory.md §3.2 for the argument
/// that APARTMENT/COMMERCIAL_TOWER share a shape (HIGH_RISE), and
/// PLOTTED/COMMERCIAL_PLOT/FARMHOUSE/VILLA share a shape (LAND_BASED).
/// Category (residential vs commercial, apartment vs villa) is separate
/// and already lives on the ProjectType master row.
///
/// **Immutable after creation.** See §13.3 — enforced at the service
/// layer, and this immutability is what unlocks Unit.shape's
/// denormalisation and the exact CHECK constraint in §13.2.
enum InventoryShape {
  HIGH_RISE // Project → Tower → Floor → Unit (existing behaviour)
  LAND_BASED // Project → (optional InventoryGroup) → Unit (plots, farmhouses, villas)
}

/// Land measurement units. Five values, exhaustive at ship —
/// see §6 for the argument on bigha (deferred).
enum AreaUnit {
  SQFT
  SQYD
  SQM
  ACRE
  GUNTA
}

model UnitType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  units     Unit[]
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("unit_types")
}

model PlcType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  unitPlcs  UnitPlc[]

  @@unique([companyId, name])
  @@map("plc_types")
}

model Project {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  name                String         @db.VarChar(255)
  code                String         @db.VarChar(50)
  /// Inventory hierarchy shape — see InventoryShape doc comment.
  /// Immutable after creation (§13.3); enforced at the service layer,
  /// and this is what unlocks Unit.shape's denormalisation and the
  /// exact CHECK constraint on units.
  shape               InventoryShape @default(HIGH_RISE)
  /// Default entered-unit picker in the LAND_BASED unit-create form.
  /// Null (or ignored) for HIGH_RISE. Per-unit source of truth is
  /// Unit.landAreaEnteredUnit, which the wizard defaults from this.
  landAreaDefaultUnit AreaUnit?      @map("land_area_default_unit")
  projectTypeId       String?        @map("project_type_id") @db.Uuid
  reraNumber          String?        @map("rera_number") @db.VarChar(100)
  areaLocationId      String?        @map("area_location_id") @db.Uuid
  address             String?        @db.Text
  description         String?        @db.Text
  startDate           DateTime?      @map("start_date") @db.Date
  expectedEndDate     DateTime?      @map("expected_end_date") @db.Date
  isActive            Boolean        @default(true) @map("is_active")
  // v0.2.3: see Unit.customFields for the shared contract.
  customFields        Json?          @map("custom_fields")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  company             Company                 @relation(fields: [companyId], references: [id])
  projectType         ProjectType?            @relation(fields: [projectTypeId], references: [id])
  areaLocation        AreaLocation?           @relation(fields: [areaLocationId], references: [id])
  towers              Tower[]
  units               Unit[]
  inventoryGroups     InventoryGroup[]
  stageRaises         StageRaise[]
  inquiries           Inquiry[]
  assignmentPools     ProjectAssignmentPool[]
  constructionUpdates ConstructionUpdate[]
  media               ProjectMedia[]

  @@unique([companyId, code])
  @@map("projects")
}

model Tower {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String   @db.VarChar(255)
  code        String   @db.VarChar(50)
  totalFloors Int      @default(0) @map("total_floors")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  floors  Floor[]

  @@unique([projectId, code])
  @@map("towers")
}

model Floor {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  towerId     String   @map("tower_id") @db.Uuid
  name        String   @db.VarChar(100)
  floorNumber Int      @map("floor_number")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  tower   Tower   @relation(fields: [towerId], references: [id])
  units   Unit[]

  @@unique([towerId, floorNumber])
  @@map("floors")
}

/// Optional grouping for LAND_BASED units: Sector / Block / Cluster /
/// Phase. Purely a filter/rollup aid — nothing prices or bookings-
/// gates off it — so it stays a single flat model rather than a
/// Tower/Floor-style two-level hierarchy. HIGH_RISE units never
/// reference this; enforced by the same CHECK constraint that
/// forces floorId on HIGH_RISE.
model InventoryGroup {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @db.VarChar(50)
  /// Free-form: "Sector" / "Block" / "Cluster" / "Phase". Displayed
  /// as the group's label in list views; not enum-restricted because
  /// the vocabulary varies by developer and no logic branches on it.
  kind      String?  @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  units   Unit[]

  @@unique([projectId, code])
  @@index([projectId, isActive])
  @@map("inventory_groups")
}

model Unit {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  /// Direct FK to Project — added because LAND_BASED units may have
  /// no floor at all, so the old walk through floor.tower.project
  /// stops working for them. Populated for every unit (backfilled
  /// from floor.tower.project for existing HIGH_RISE rows in the
  /// migration; always set at unit-create for new rows).
  projectId           String         @map("project_id") @db.Uuid
  /// Denormalised from Project.shape. Safe because Project.shape is
  /// immutable after creation (§13.3), so this copy CANNOT drift —
  /// the invariant is enforced by never writing this column except
  /// at unit-create from the parent Project's shape. In exchange we
  /// get a row-level CHECK constraint that is EXACT (not the coarse
  /// guardrail revision 1 proposed) and every report that filters
  /// by shape can do so without joining to projects.
  shape               InventoryShape @map("shape")
  /// Nullable now: LAND_BASED units have no floor. Every HIGH_RISE
  /// unit still requires one — enforced by the CHECK constraint added
  /// alongside this migration.
  floorId             String?        @map("floor_id") @db.Uuid
  /// Optional grouping for LAND_BASED units (Sector / Block / Cluster).
  /// Null on HIGH_RISE units — enforced by the same CHECK constraint.
  inventoryGroupId    String?        @map("inventory_group_id") @db.Uuid
  unitTypeId          String?        @map("unit_type_id") @db.Uuid
  number              String         @db.VarChar(50)
  status              UnitStatus     @default(AVAILABLE)
  // HIGH_RISE area fields (unchanged).
  carpetAreaSqft      Decimal?       @map("carpet_area_sqft") @db.Decimal(10, 2)
  builtUpAreaSqft     Decimal?       @map("built_up_area_sqft") @db.Decimal(10, 2)
  superBuiltUpSqft    Decimal?       @map("super_built_up_sqft") @db.Decimal(10, 2)
  // LAND_BASED area fields. See §7.1 for the two-column rationale:
  // pricing reads landAreaEntered + landAreaEnteredUnit directly (no
  // divide-through-sqft rounding); landAreaSqft is a DERIVED
  // projection for reports/filters, invariant enforced at write.
  // Null on HIGH_RISE units.
  landAreaEntered     Decimal?       @map("land_area_entered") @db.Decimal(20, 6)
  landAreaEnteredUnit AreaUnit?      @map("land_area_entered_unit")
  landAreaSqft        Decimal?       @map("land_area_sqft") @db.Decimal(20, 6)
  /// Free-form land-record identifier — state vocabulary varies
  /// (khasra, survey number, RTC, hissa, patta), so the column is
  /// generic and the per-project display label is admin-configured.
  landRecordRef       String?        @map("land_record_ref") @db.VarChar(100)
  /// Facing direction — cardinal + intercardinal (N/S/E/W/NE/NW/SE/SW).
  facing              String?        @db.VarChar(20)
  /// Plot dimensions in feet — first-class because sorting and
  /// filtering pivot on them. Null on apartments.
  lengthFeet          Decimal?       @map("length_feet") @db.Decimal(10, 2)
  breadthFeet         Decimal?       @map("breadth_feet") @db.Decimal(10, 2)
  /// baseRatePaise is now paise per Unit.rateUnit, not always
  /// paise/sqft. HIGH_RISE units have rateUnit=SQFT (backfill is a
  /// no-op interpretation change). LAND_BASED units carry the unit
  /// the client actually entered — most commonly ACRE for farmland
  /// — and the rate is stored EXACTLY, not divided through sqft
  /// (which was lossy: ₹5,00,000/acre normalised to 1,147 paise/sqft
  /// loses ₹366.80 per acre). §7 for the arithmetic.
  baseRatePaise       BigInt         @default(0) @map("base_rate_paise")
  rateUnit            AreaUnit       @default(SQFT) @map("rate_unit")
  /// Farmhouse-shaped units price land (baseRatePaise per rateUnit)
  /// and covered structure (builtUpRatePaise, paise/sqft) separately.
  /// Null on plots-only and on apartments. Drops if the client's
  /// farmhouse pricing turns out to be a single combined rate.
  builtUpRatePaise    BigInt?        @map("built_up_rate_paise")
  isActive            Boolean        @default(true) @map("is_active")
  // v0.2.3: admin-defined custom field VALUES, keyed by
  // CustomFieldDefinition.key (immutable, so a label rename never
  // orphans a value). Validated server-side against the active
  // definitions for this entityType — never trusted from the client.
  customFields        Json?          @map("custom_fields")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  company        Company            @relation(fields: [companyId], references: [id])
  project        Project            @relation(fields: [projectId], references: [id])
  floor          Floor?             @relation(fields: [floorId], references: [id])
  inventoryGroup InventoryGroup?    @relation(fields: [inventoryGroupId], references: [id])
  unitType       UnitType?          @relation(fields: [unitTypeId], references: [id])
  plcs           UnitPlc[]
  charges        UnitCharge[]
  rateRevisions  UnitRateRevision[]
  statusChanges  UnitStatusChange[]
  bookings       Booking[]

  @@unique([floorId, number])
  @@index([projectId, status])
  @@index([inventoryGroupId, status])
  @@map("units")
}

model UnitPlc {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  plcTypeId   String   @map("plc_type_id") @db.Uuid
  amountPaise BigInt   @map("amount_paise")
  percentage  Decimal? @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  plcType PlcType @relation(fields: [plcTypeId], references: [id])

  @@unique([unitId, plcTypeId])
  @@map("unit_plcs")
}

model UnitCharge {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  chargeTypeId String   @map("charge_type_id") @db.Uuid
  amountPaise  BigInt   @map("amount_paise")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeId], references: [id])

  @@unique([unitId, chargeTypeId])
  @@map("unit_charges")
}

model UnitRateRevision {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  unitId        String   @map("unit_id") @db.Uuid
  ratePaise     BigInt   @map("rate_paise")
  /// Unit that `ratePaise` is denominated in. HIGH_RISE units have
  /// always priced per sqft; existing rows backfill to SQFT (no
  /// interpretation change). Kept even for HIGH_RISE going forward
  /// so a shape-agnostic pricing service does not have to consult
  /// the parent unit to know what unit the revision is in.
  rateUnit      AreaUnit @default(SQFT) @map("rate_unit")
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String?  @db.VarChar(500)
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("rateRevisionCreator", fields: [createdById], references: [id])

  @@unique([unitId, effectiveFrom])
  @@map("unit_rate_revisions")
}

model UnitStatusChange {
  id         String     @id @default(uuid()) @db.Uuid
  companyId  String     @map("company_id") @db.Uuid
  unitId     String     @map("unit_id") @db.Uuid
  fromStatus UnitStatus @map("from_status")
  toStatus   UnitStatus @map("to_status")
  reason     String?    @db.VarChar(500)
  actorType  String     @map("actor_type") @db.VarChar(20)
  actorId    String?    @map("actor_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actor   User?   @relation("statusChangeActor", fields: [actorId], references: [id])

  @@index([unitId, createdAt])
  @@map("unit_status_changes")
}

// ─── Phase 3: Pre-sales — inquiries, assignment, follow-ups ───

model Applicant {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  name                   String    @db.VarChar(255)
  primaryPhone           String    @map("primary_phone") @db.VarChar(20)
  primaryPhoneNormalized String    @map("primary_phone_normalized") @db.VarChar(20)
  alternatePhones        String[]  @map("alternate_phones")
  email                  String?   @db.VarChar(255)
  emailNormalized        String?   @map("email_normalized") @db.VarChar(255)
  addressLine1           String?   @map("address_line1") @db.VarChar(255)
  city                   String?   @db.VarChar(100)
  state                  String?   @db.VarChar(100)
  pincode                String?   @db.VarChar(10)
  // Used by the birthday-list report only; optional, never required at intake.
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  customFields           Json?     @map("custom_fields")
  // PAN encrypted at rest (AES-256-GCM, PAN_ENCRYPTION_KEY). panMasked is the
  // display form (e.g. "XXXXX1234X"). panKeyVersion lets a future key rotation
  // re-encrypt without a schema migration — no rotation logic exists yet.
  panCiphertext          String?   @map("pan_ciphertext") @db.Text
  panMasked              String?   @map("pan_masked") @db.VarChar(15)
  panKeyVersion          Int       @default(1) @map("pan_key_version") @db.SmallInt
  mergedIntoId           String?   @map("merged_into_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company            Company                 @relation(fields: [companyId], references: [id])
  mergedInto         Applicant?              @relation("applicantMergeChain", fields: [mergedIntoId], references: [id])
  mergedFrom         Applicant[]             @relation("applicantMergeChain")
  consents           ApplicantConsent[]
  survivorOfMerges   ApplicantMerge[]        @relation("mergeSurvivor")
  absorbedInMerge    ApplicantMerge?         @relation("mergeAbsorbed")
  distinctPairsAsA   ApplicantDistinctPair[] @relation("distinctPairA")
  distinctPairsAsB   ApplicantDistinctPair[] @relation("distinctPairB")
  inquiries          Inquiry[]
  communicationLogs  CommunicationLog[]
  addresses          ApplicantAddress[]
  documents          ApplicantDocument[]
  primaryBookings    Booking[]               @relation("bookingPrimaryApplicant")
  coApplicantOf      BookingCoApplicant[]
  generatedDocuments GeneratedDocument[]
  documentDispatches DocumentDispatch[]

  @@index([companyId, primaryPhoneNormalized])
  @@index([companyId, emailNormalized])
  @@map("applicants")
}

/// Append-only consent ledger. Current consent = latest row per applicant.
/// Never updated or deleted — revoking/re-granting inserts a new row.
model ApplicantConsent {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  given       Boolean
  source      String?  @map("source") @db.VarChar(100)
  actorId     String?  @map("actor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  actor     User?     @relation("consentActor", fields: [actorId], references: [id])

  @@index([applicantId, createdAt])
  @@map("applicant_consents")
}

model ApplicantMerge {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  survivorId String   @map("survivor_id") @db.Uuid
  mergedId   String   @unique @map("merged_id") @db.Uuid
  mergedById String?  @map("merged_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  survivor Applicant @relation("mergeSurvivor", fields: [survivorId], references: [id])
  merged   Applicant @relation("mergeAbsorbed", fields: [mergedId], references: [id])
  mergedBy User?     @relation("applicantMergeActor", fields: [mergedById], references: [id])

  @@map("applicant_merges")
}

/// The deliberate opposite of ApplicantMerge: a persisted "these are
/// different people" decision, not "these are the same." Composes with
/// merge — once a human decides two applicants sharing a phone/email are
/// NOT the same person, ApplicantService.findDuplicates() stops flagging
/// that exact pair again. Always stored with applicantAId < applicantBId
/// (lexicographic UUID compare, enforced at the service layer — Postgres
/// has no native "smaller of two UUID columns" constraint), so a lookup
/// never needs to check both orderings.
model ApplicantDistinctPair {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  applicantAId String   @map("applicant_a_id") @db.Uuid
  applicantBId String   @map("applicant_b_id") @db.Uuid
  decidedById  String?  @map("decided_by_id") @db.Uuid
  decidedAt    DateTime @default(now()) @map("decided_at")

  company    Company   @relation(fields: [companyId], references: [id])
  applicantA Applicant @relation("distinctPairA", fields: [applicantAId], references: [id], onDelete: Cascade)
  applicantB Applicant @relation("distinctPairB", fields: [applicantBId], references: [id], onDelete: Cascade)
  decidedBy  User?     @relation("applicantDistinctPairDecider", fields: [decidedById], references: [id])

  @@unique([companyId, applicantAId, applicantBId])
  @@map("applicant_distinct_pairs")
}

model InquiryTemperature {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("inquiry_temperatures")
}

enum InquiryStatus {
  OPEN
  CONTINUED
  DUMPED
  SUCCESSFUL
}

/// Company-configurable sales-pipeline position — orthogonal to
/// InquiryStatus, not a replacement for it. Status is the coarse
/// lifecycle disposition (open/paused/dead/won) and stays load-bearing
/// elsewhere (EscalationService gates on OPEN/CONTINUED; convertedAt is
/// keyed off the transition into SUCCESSFUL). LeadStage is "where in
/// OUR pipeline is this lead" — only meaningful while a lead is
/// OPEN/CONTINUED, but Inquiry.stageId is never cleared on a terminal
/// transition: which stage a lead died at, or converted from, is the
/// most actionable drop-off/win metric there is. See feature-completion-
/// plan.md's Phase 0 (lead stage foundation).
model LeadStage {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// The stage a newly-created inquiry starts at when the caller doesn't
  /// specify one. Enforced unique per company by a partial index
  /// (lead_stages_one_default_per_company, migration SQL) — the actual
  /// correctness guarantee, not this column alone. The service layer
  /// also clears the prior default in the same transaction as setting a
  /// new one, purely so a single request doesn't 409 against its own
  /// prior default.
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company               @relation(fields: [companyId], references: [id])
  inquiries   Inquiry[]
  fromHistory InquiryStageHistory[] @relation("stageHistoryFrom")
  toHistory   InquiryStageHistory[] @relation("stageHistoryTo")

  @@unique([companyId, name])
  @@map("lead_stages")
}

/// convertedAt: see the field's own comment — added because the dashboard
/// needs a conversion DATE that does not move when someone edits a closed
/// lead.
model Inquiry {
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  applicantId         String        @map("applicant_id") @db.Uuid
  projectId           String?       @map("project_id") @db.Uuid
  sourceId            String?       @map("source_id") @db.Uuid
  inquiryTypeId       String?       @map("inquiry_type_id") @db.Uuid
  budgetMinPaise      BigInt?       @map("budget_min_paise")
  budgetMaxPaise      BigInt?       @map("budget_max_paise")
  preferredUnitTypeId String?       @map("preferred_unit_type_id") @db.Uuid
  temperatureId       String?       @map("temperature_id") @db.Uuid
  /// Company-configurable pipeline position — see LeadStage's own doc
  /// comment. Deliberately NEVER cleared on a status transition to
  /// DUMPED/SUCCESSFUL; only UI/report queries scope by status.
  stageId             String?       @map("stage_id") @db.Uuid
  assignedToId        String?       @map("assigned_to_id") @db.Uuid
  // Who created this inquiry, when a human did (interactive create()).
  // Null for machine-driven intake (inbound lead API, bulk import) — there
  // is no human creator to attribute those to. Drives the creator-retains
  // assignment policy in InquiryService.create(); never mutated after.
  createdById         String?       @map("created_by_id") @db.Uuid
  status              InquiryStatus @default(OPEN)
  /// When this inquiry last became SUCCESSFUL. Written by
  /// InquiryService.update() on the transition INTO that status and
  /// cleared on any transition out of it — deliberately not derived from
  /// updatedAt, which every unrelated edit bumps: keying the dashboard's
  /// conversion figure off updatedAt meant editing a lead closed months
  /// ago silently re-dated it into the current month and moved a
  /// manager's team-performance number. Nullable, and null for rows
  /// closed before this column existed only where the backfill had
  /// nothing better to use.
  convertedAt         DateTime?     @map("converted_at")
  nextFollowupAt      DateTime?     @map("next_followup_at")
  lastEscalatedAt     DateTime?     @map("last_escalated_at")
  customFields        Json?         @map("custom_fields")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  company            Company                     @relation(fields: [companyId], references: [id])
  applicant          Applicant                   @relation(fields: [applicantId], references: [id])
  project            Project?                    @relation(fields: [projectId], references: [id])
  source             InquirySource?              @relation(fields: [sourceId], references: [id])
  inquiryType        InquiryType?                @relation(fields: [inquiryTypeId], references: [id])
  preferredUnitType  UnitType?                   @relation(fields: [preferredUnitTypeId], references: [id])
  temperature        InquiryTemperature?         @relation(fields: [temperatureId], references: [id])
  stage              LeadStage?                  @relation(fields: [stageId], references: [id])
  assignedTo         User?                       @relation("inquiryAssignee", fields: [assignedToId], references: [id])
  createdBy          User?                       @relation("inquiryCreator", fields: [createdById], references: [id])
  followUps          FollowUp[]
  assignments        InquiryAssignment[]
  stageHistory       InquiryStageHistory[]
  dispositionHistory InquiryDispositionHistory[]
  communicationLogs  CommunicationLog[]

  @@index([companyId, assignedToId, status])
  @@index([companyId, nextFollowupAt])
  @@index([companyId, status, createdAt])
  /// Serves the dashboard's per-scope conversion counts.
  @@index([companyId, convertedAt])
  @@index([companyId, stageId])
  @@map("inquiries")
}

model InquiryAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  inquiryId      String   @map("inquiry_id") @db.Uuid
  fromUserId     String?  @map("from_user_id") @db.Uuid
  toUserId       String   @map("to_user_id") @db.Uuid
  assignmentType String   @map("assignment_type") @db.VarChar(20)
  actorId        String?  @map("actor_id") @db.Uuid
  reason         String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  company  Company @relation(fields: [companyId], references: [id])
  inquiry  Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromUser User?   @relation("assignmentFrom", fields: [fromUserId], references: [id])
  toUser   User    @relation("assignmentTo", fields: [toUserId], references: [id])
  actor    User?   @relation("assignmentActor", fields: [actorId], references: [id])

  @@index([inquiryId, createdAt])
  @@map("inquiry_assignments")
}

/// One row per stage transition — including the initial null -> default
/// assignment at creation, so history is gap-free from row one. Mirrors
/// InquiryAssignment's shape exactly (from/to/actor/createdAt). Written
/// by every inquiry-creation path (InquiryService.create,
/// InquiryService.createFromLead, InquiryImportService's bulk import)
/// and by InquiryService.update whenever stageId changes, plus a bulk
/// write when a stage is deactivated-with-reassignment
/// (LeadStageService). Never backfilled or corrected in place — a
/// wrong transition gets a new row, same append-only discipline as
/// every other history table in this codebase.
///
/// isAdministrative distinguishes a real sales-pipeline movement (a rep
/// advancing a lead, or the initial default-stage assignment at
/// creation) from a bulk system-driven move — currently only
/// LeadStageService.reassignOccupants, which can move thousands of
/// leads onto one target stage in a single request when an admin
/// deactivates an occupied stage, often moving them BACKWARD through
/// the pipeline. Written once, at insert time, and never revisited —
/// same now-or-never reasoning as this table's own existence: once a
/// row exists, there is no way to tell an administrative move from a
/// real one after the fact except this flag. Phase 3's funnel report
/// must exclude isAdministrative rows by default, or a single stage
/// retirement would look like thousands of leads reaching (or
/// regressing into) that stage on one date.
model InquiryStageHistory {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  inquiryId        String   @map("inquiry_id") @db.Uuid
  fromStageId      String?  @map("from_stage_id") @db.Uuid
  toStageId        String   @map("to_stage_id") @db.Uuid
  changedById      String?  @map("changed_by_id") @db.Uuid
  /// True only for LeadStageService.reassignOccupants' bulk moves.
  /// Every other writer (inquiry creation, the InquiryDetail stage
  /// picker) leaves this false — those are real pipeline movements.
  isAdministrative Boolean  @default(false) @map("is_administrative")
  changedAt        DateTime @default(now()) @map("changed_at")

  company   Company    @relation(fields: [companyId], references: [id])
  inquiry   Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStage LeadStage? @relation("stageHistoryFrom", fields: [fromStageId], references: [id])
  toStage   LeadStage  @relation("stageHistoryTo", fields: [toStageId], references: [id])
  changedBy User?      @relation("stageHistoryChangedBy", fields: [changedById], references: [id])

  @@index([companyId, inquiryId, changedAt])
  @@map("inquiry_stage_history")
}

/// Follow-Up Page spec gap #2 (docs/plans/followup-spec-gap-analysis.md,
/// SOP rule 5): "the SOP screenshot shows a reason-selection control with
/// multiple possible reasons, but the textual SOP does not provide a
/// canonical complete list ... treated as configurable master data."
/// Deliberately seeded with ZERO default rows, unlike LeadStage — the
/// SOP gave real example Response values worth seeding; it explicitly
/// does NOT give real Dump Reason values, so inventing some here would
/// be exactly the kind of guess this project's own review keeps getting
/// burned by. A company must configure at least one before Dump becomes
/// usable, which is the correct, honest outcome.
model DumpReason {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company                     @relation(fields: [companyId], references: [id])
  history InquiryDispositionHistory[]

  @@unique([companyId, name])
  @@map("dump_reasons")
}

/// Closes the one axis of three (companyId, inquiryId) that lacked a
/// dedicated history table — stage transitions have InquiryStageHistory,
/// ownership transitions have InquiryAssignment, but InquiryStatus itself
/// (OPEN/CONTINUED/DUMPED/SUCCESSFUL) was a plain column overwritten in
/// place with no history row (see the gap analysis's Definition-of-Done
/// item 23: "true for stage and ownership; false for status itself").
/// Written on EVERY status transition, including the initial null->OPEN
/// at creation, for the same gap-free-from-row-one reason
/// InquiryStageHistory's own doc comment gives — not just for DUMPED.
/// `reasonId`/`remarks` are generic, nullable columns populated only
/// when the transition needs them (currently: only DUMPED does, per SOP
/// rule 5) — same "one optional column, used when relevant" shape as
/// InquiryAssignment.reason, not a Dump-specific table.
model InquiryDispositionHistory {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  inquiryId   String         @map("inquiry_id") @db.Uuid
  fromStatus  InquiryStatus? @map("from_status")
  toStatus    InquiryStatus  @map("to_status")
  reasonId    String?        @map("reason_id") @db.Uuid
  remarks     String?        @db.Text
  changedById String?        @map("changed_by_id") @db.Uuid
  changedAt   DateTime       @default(now()) @map("changed_at")

  company   Company     @relation(fields: [companyId], references: [id])
  inquiry   Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  reason    DumpReason? @relation(fields: [reasonId], references: [id])
  changedBy User?       @relation("dispositionHistoryChangedBy", fields: [changedById], references: [id])

  @@index([companyId, inquiryId, changedAt])
  @@map("inquiry_disposition_history")
}

model ProjectAssignmentPool {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  pausedReason   String?   @map("paused_reason") @db.VarChar(100)
  lastAssignedAt DateTime? @map("last_assigned_at") @db.Timestamp(6)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("assignmentPoolMember", fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([companyId, projectId, isActive])
  @@map("project_assignment_pools")
}

enum FollowUpOutcome {
  COMPLETED
  NO_RESPONSE
  RESCHEDULED
  NOT_INTERESTED
  CONVERTED
}

model FollowUp {
  id            String           @id @default(uuid()) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  inquiryId     String           @map("inquiry_id") @db.Uuid
  typeId        String?          @map("follow_up_type_id") @db.Uuid
  notes         String?          @db.Text
  outcome       FollowUpOutcome?
  /// When the interaction itself happened — distinct from `createdAt`
  /// (when the row was saved) and from `nextActionAt` (when the NEXT one
  /// is due). User-settable so a rep can log a call that happened
  /// yesterday; defaults to the injected Clock's `now()` when omitted
  /// (set in FollowUpService, not relied on as a bare DB default, for
  /// the same testability reason every other Clock-driven field in this
  /// codebase is set explicitly).
  interactionAt DateTime         @default(now()) @map("interaction_at")
  nextActionAt  DateTime?        @map("next_action_at")
  scheduledAt   DateTime?        @map("scheduled_at")
  venue         String?          @db.VarChar(255)
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  company   Company       @relation(fields: [companyId], references: [id])
  inquiry   Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type      FollowUpType? @relation(fields: [typeId], references: [id])
  createdBy User?         @relation("followUpCreator", fields: [createdById], references: [id])

  @@index([companyId, inquiryId, createdAt])
  @@index([companyId, nextActionAt])
  @@map("follow_ups")
}

model SmsTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String   @db.VarChar(255)
  dltTemplateId String   @map("dlt_template_id") @db.VarChar(50)
  senderId      String   @map("sender_id") @db.VarChar(11)
  headerId      String?  @map("header_id") @db.VarChar(50)
  body          String   @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  company       Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("sms_templates")
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationStatus {
  QUEUED
  SENT
  FAILED
}

/// Append-only send ledger. applicantId is NEVER reassigned on applicant
/// merge — it always identifies the original recipient of the message,
/// even if that applicant is later merged into a survivor (see CLAUDE.md
/// Phase 3 decisions).
model CommunicationLog {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  inquiryId         String?              @map("inquiry_id") @db.Uuid
  applicantId       String               @map("applicant_id") @db.Uuid
  channel           CommunicationChannel
  toAddress         String               @map("to_address") @db.VarChar(255)
  subject           String?              @db.VarChar(500)
  body              String               @db.Text
  status            CommunicationStatus  @default(QUEUED)
  providerMessageId String?              @map("provider_message_id") @db.VarChar(255)
  errorMessage      String?              @map("error_message") @db.Text
  sentAt            DateTime?            @map("sent_at")
  createdById       String?              @map("created_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  inquiry   Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  applicant Applicant @relation(fields: [applicantId], references: [id])
  createdBy User?     @relation("commLogCreator", fields: [createdById], references: [id])

  @@index([companyId, applicantId, createdAt])
  @@map("communication_logs")
}

// ─── Phase 4: Financial core — bookings, ledger, receipts ─────
//
// Relation policy for Phase 4: the core financial graph (Booking, Installment,
// LedgerEntry, Receipt, …) uses full Prisma relations. Master/config FKs
// (chargeTypeId, gstRateId, bankId, receiptTypeId, interestRuleId,
// transferFeeRuleId, cancellationRuleId, paymentPlanTemplateId, documentTypeId)
// and user FKs (createdById, approvedById, verifiedById, uploadedById) are
// plain @db.Uuid scalars WITHOUT Prisma relations — their FK constraints are
// added at the DB level in the migration. This keeps User and the master
// models from accumulating dozens of back-relations while preserving
// referential integrity in Postgres.

enum AddressType {
  OFFICE
  PERMANENT
  PRESENT
}

model ApplicantAddress {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  applicantId String      @map("applicant_id") @db.Uuid
  addressType AddressType @map("address_type")
  line1       String      @db.VarChar(255)
  line2       String?     @db.VarChar(255)
  city        String?     @db.VarChar(100)
  state       String?     @db.VarChar(100)
  stateCode   String?     @map("state_code") @db.VarChar(2)
  pincode     String?     @db.VarChar(10)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([applicantId, addressType])
  @@map("applicant_addresses")
}

model ApplicantDocument {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  applicantId    String   @map("applicant_id") @db.Uuid
  documentTypeId String?  @map("document_type_id") @db.Uuid
  storedName     String   @map("stored_name") @db.VarChar(255)
  originalName   String   @map("original_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  sizeBytes      Int      @map("size_bytes")
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([companyId, applicantId])
  @@map("applicant_documents")
}

model CancellationRule {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  name                 String   @db.VarChar(255)
  deductionType        String   @map("deduction_type") @db.VarChar(20) // PERCENT | FLAT
  deductionPercent     Decimal? @map("deduction_percent") @db.Decimal(5, 2)
  deductionAmountPaise BigInt?  @map("deduction_amount_paise")
  forfeitBookingAmount Boolean  @default(false) @map("forfeit_booking_amount")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  company              Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("cancellation_rules")
}

enum BookingStatus {
  APPLICATION
  BOOKED
  ALLOTTED
  REGISTERED
  CANCELLED
  SURRENDERED
  TRANSFERRED_OUT
}

model Booking {
  id                     String        @id @default(uuid()) @db.Uuid
  companyId              String        @map("company_id") @db.Uuid
  unitId                 String        @map("unit_id") @db.Uuid
  primaryApplicantId     String        @map("primary_applicant_id") @db.Uuid
  bookingNumber          String        @map("booking_number") @db.VarChar(40)
  status                 BookingStatus @default(APPLICATION)
  agreedPricePaise       BigInt        @map("agreed_price_paise")
  // Snapshot of the GST place-of-supply state code, taken at booking and
  // immutable thereafter. Per IGST Act §12(3)(a), the place of supply of
  // services directly in relation to immovable property is the LOCATION OF
  // THE PROPERTY — not the customer's residential state. Defaulted from the
  // project/area-location state at creation, overridable then, frozen after.
  // Do not "fix" this to follow the applicant's address.
  placeOfSupplyStateCode String?       @map("place_of_supply_state_code") @db.VarChar(2)
  paymentPlanTemplateId  String?       @map("payment_plan_template_id") @db.Uuid
  // Interest rule for overdue installments (Phase 4). Null = no delay interest.
  // Scalar + DB-level FK (no Prisma relation).
  interestRuleId         String?       @map("interest_rule_id") @db.Uuid
  // Sourcing broker (Phase 5). Null = unsourced booking, no commission/NOC
  // gating at all. Scalar + DB-level FK (no Prisma relation), same policy
  // as interestRuleId above — set by a Phase 5 controller-layer call after
  // the booking exists, never by BookingService itself.
  brokerId               String?       @map("broker_id") @db.Uuid
  bookingDate            DateTime      @map("booking_date") @db.Date
  allotmentDate          DateTime?     @map("allotment_date") @db.Date
  registrationDate       DateTime?     @map("registration_date") @db.Date
  cancelledAt            DateTime?     @map("cancelled_at")
  createdById            String?       @map("created_by_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  company            Company              @relation(fields: [companyId], references: [id])
  unit               Unit                 @relation(fields: [unitId], references: [id])
  primaryApplicant   Applicant            @relation("bookingPrimaryApplicant", fields: [primaryApplicantId], references: [id])
  coApplicants       BookingCoApplicant[]
  costLines          BookingCostLine[]
  paymentPlans       PaymentPlan[]
  installments       Installment[]
  ledgerEntries      LedgerEntry[]
  receipts           Receipt[]
  transfersFrom      Transfer[]           @relation("transferFrom")
  transfersTo        Transfer[]           @relation("transferTo")
  cancellations      Cancellation[]
  refunds            Refund[]
  paymentVouchers    PaymentVoucher[]
  extraCharges       ExtraCharge[]
  tdsDeductions      TdsDeduction[]
  interestAccruals   InterestAccrual[]
  generatedDocuments GeneratedDocument[]
  documentDispatches DocumentDispatch[]

  @@unique([companyId, bookingNumber])
  @@index([companyId, status])
  @@index([companyId, unitId])
  @@map("bookings")
}

model BookingCoApplicant {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  ordinal     Int      @default(2)
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  applicant Applicant @relation(fields: [applicantId], references: [id])

  @@unique([bookingId, applicantId])
  @@map("booking_co_applicants")
}

enum CostLineKind {
  BASE
  PLC
  PARKING
  CLUB
  MAINTENANCE
  OTHER
}

/// Snapshot of a booking's agreed cost breakup, taken at booking time.
/// The GST rate is captured here (gstRatePercentSnapshot) and immutable —
/// re-pricing the charge master later never changes an existing booking.
model BookingCostLine {
  id                     String       @id @default(uuid()) @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  bookingId              String       @map("booking_id") @db.Uuid
  kind                   CostLineKind
  chargeTypeId           String?      @map("charge_type_id") @db.Uuid
  label                  String       @db.VarChar(255)
  baseAmountPaise        BigInt       @map("base_amount_paise")
  gstRateId              String?      @map("gst_rate_id") @db.Uuid
  gstRatePercentSnapshot Decimal      @default(0) @map("gst_rate_percent_snapshot") @db.Decimal(5, 2)
  cgstPaise              BigInt       @default(0) @map("cgst_paise")
  sgstPaise              BigInt       @default(0) @map("sgst_paise")
  igstPaise              BigInt       @default(0) @map("igst_paise")
  lineTotalPaise         BigInt       @map("line_total_paise")
  sortOrder              Int          @default(0) @map("sort_order")
  createdAt              DateTime     @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([companyId, bookingId])
  @@map("booking_cost_lines")
}

model PaymentPlan {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid
  name        String   @db.VarChar(255)
  isCustom    Boolean  @default(false) @map("is_custom")
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([companyId, bookingId])
  @@map("payment_plans")
}

enum InstallmentStatus {
  UNPAID
  PART_PAID
  PAID
}

/// An installment is FROZEN (immutable, may not be edited or regenerated)
/// exactly when allocatedPaise > 0. There is no separate isFrozen column —
/// allocatedPaise (a maintained cache of Σ ReceiptAllocation) is the single
/// source of truth for the freeze rule (see CLAUDE.md Phase 4 decisions).
model Installment {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  bookingId        String            @map("booking_id") @db.Uuid
  planId           String            @map("plan_id") @db.Uuid
  seq              Int
  label            String            @db.VarChar(255)
  /// Snapshotted from the template milestone at instantiation (same
  /// discipline as milestonePercent below) — never re-read from the
  /// template later, so a template edit can't retroactively change what
  /// an already-instantiated installment is.
  milestoneType    MilestoneType     @default(DATE_LINKED) @map("milestone_type")
  /// The source PaymentPlanMilestone.seq this row was instantiated from
  /// (joined with PaymentPlan.templateId, since Installment has no direct
  /// templateId of its own) — NULL for custom-plan installments, which
  /// have no source milestone. This is what a bulk stage raise matches
  /// against: (plan.templateId, milestoneSeq) is a stage's true identity
  /// within one project. Matching by milestonePercent or label alone
  /// would be wrong — two different milestones in the same template can
  /// share a percent (the seed's own Excavation/Plinth are both 15%).
  milestoneSeq     Int?              @map("milestone_seq")
  /// NULL means "not yet due" — true only for an unraised STAGE_LINKED
  /// installment. See docs/plans/construction-linked-demand-fix.md §2 for
  /// the full, enumerated list of every consumer's null-handling.
  dueDate          DateTime?         @map("due_date") @db.Date
  amountPaise      BigInt            @map("amount_paise")
  milestonePercent Decimal?          @map("milestone_percent") @db.Decimal(6, 3)
  allocatedPaise   BigInt            @default(0) @map("allocated_paise")
  status           InstallmentStatus @default(UNPAID)
  isActive         Boolean           @default(true) @map("is_active")
  stageRaiseId     String?           @map("stage_raise_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  plan        PaymentPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  stageRaise  StageRaise?         @relation(fields: [stageRaiseId], references: [id])
  allocations ReceiptAllocation[]

  @@index([companyId, bookingId])
  @@index([companyId, dueDate])
  @@map("installments")
}

enum LedgerEntryType {
  CHARGE
  EXTRA_CHARGE
  RECEIPT_ALLOC
  INTEREST
  INTEREST_WAIVER
  BOUNCE_REVERSAL
  BOUNCE_CHARGE
  REFUND_APPROVED
  REFUND_BOUNCE_REVERSAL
  TRANSFER_CARRY_OUT
  TRANSFER_CARRY_IN
  TRANSFER_FEE
  CANCELLATION_SETTLEMENT
  CANCELLATION_DEDUCTION
  TDS_RECEIVABLE
  TDS_CERT_ADJUSTMENT
  ADJUSTMENT
}

/// APPEND-ONLY. The booking balance is DEFINED as SUM(signed_amount_paise).
/// Positive = debit (customer owes); negative = credit (customer paid/credited).
/// Corrections are new negating rows referencing reversalOfEntryId — never an
/// UPDATE or DELETE. A DB trigger forbids UPDATE/DELETE on this table.
model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  bookingId         String          @map("booking_id") @db.Uuid
  entryType         LedgerEntryType @map("entry_type")
  signedAmountPaise BigInt          @map("signed_amount_paise")
  installmentId     String?         @map("installment_id") @db.Uuid
  receiptId         String?         @map("receipt_id") @db.Uuid
  reversalOfEntryId String?         @map("reversal_of_entry_id") @db.Uuid
  reason            String?         @db.VarChar(500)
  effectiveDate     DateTime        @map("effective_date") @db.Date
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  company    Company       @relation(fields: [companyId], references: [id])
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  receipt    Receipt?      @relation(fields: [receiptId], references: [id])
  reversalOf LedgerEntry?  @relation("ledgerReversal", fields: [reversalOfEntryId], references: [id])
  reversedBy LedgerEntry[] @relation("ledgerReversal")

  @@index([companyId, bookingId])
  @@index([companyId, entryType])
  @@map("ledger_entries")
}

enum ReceiptMode {
  CASH
  CHEQUE
  DD
  NEFT
  RTGS
  UPI
  CARD
}

enum ChequeClearanceStatus {
  NOT_APPLICABLE
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
}

model Receipt {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @map("company_id") @db.Uuid
  bookingId        String                @map("booking_id") @db.Uuid
  receiptNumber    String                @map("receipt_number") @db.VarChar(40)
  fyLabel          String                @map("fy_label") @db.VarChar(9)
  seqValue         Int                   @map("seq_value")
  receiptDate      DateTime              @map("receipt_date") @db.Date
  mode             ReceiptMode
  grossAmountPaise BigInt                @map("gross_amount_paise")
  receiptTypeId    String?               @map("receipt_type_id") @db.Uuid
  bankId           String?               @map("bank_id") @db.Uuid
  instrumentNumber String?               @map("instrument_number") @db.VarChar(50)
  instrumentDate   DateTime?             @map("instrument_date") @db.Date
  utr              String?               @db.VarChar(50)
  clearanceStatus  ChequeClearanceStatus @default(NOT_APPLICABLE) @map("clearance_status")
  isReversed       Boolean               @default(false) @map("is_reversed")
  reversalReason   String?               @map("reversal_reason") @db.VarChar(500)
  reprintCount     Int                   @default(0) @map("reprint_count")
  createdById      String?               @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id])
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  allocations   ReceiptAllocation[]
  chequeEvents  ChequeStatusEvent[]
  ledgerEntries LedgerEntry[]
  tdsDeductions TdsDeduction[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, bookingId])
  @@map("receipts")
}

/// APPEND-ONLY. Which installment(s) a receipt settled. Σ allocations ==
/// receipt gross. A DB trigger forbids UPDATE/DELETE.
model ReceiptAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  receiptId     String   @map("receipt_id") @db.Uuid
  installmentId String   @map("installment_id") @db.Uuid
  amountPaise   BigInt   @map("amount_paise")
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company     @relation(fields: [companyId], references: [id])
  receipt     Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id])

  @@index([companyId, installmentId])
  @@map("receipt_allocations")
}

/// APPEND-ONLY cheque lifecycle log. The cached Receipt.clearanceStatus is
/// derived from the latest event. A DB trigger forbids UPDATE/DELETE.
model ChequeStatusEvent {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String                @map("company_id") @db.Uuid
  receiptId   String                @map("receipt_id") @db.Uuid
  status      ChequeClearanceStatus
  eventDate   DateTime              @map("event_date") @db.Date
  reason      String?               @db.VarChar(500)
  createdById String?               @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([companyId, receiptId, createdAt])
  @@map("cheque_status_events")
}

/// Gap-free document-number allocator. Incremented inside the same
/// transaction as the row it numbers (e.g. a receipt); a rolled-back
/// transaction releases its number, so committed rows are strictly
/// contiguous per (company, kind, scope). Not append-only — it is a counter.
model NumberSequence {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  kind       String   @db.VarChar(30) // RECEIPT | BOOKING | …
  scopeLabel String   @map("scope_label") @db.VarChar(20) // FY label, or GLOBAL
  nextValue  Int      @default(1) @map("next_value")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, kind, scopeLabel])
  @@map("number_sequences")
}

enum TransferType {
  UNIT
  APPLICANT
}

model Transfer {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  fromBookingId     String       @map("from_booking_id") @db.Uuid
  toBookingId       String?      @map("to_booking_id") @db.Uuid
  transferType      TransferType @map("transfer_type")
  transferFeeRuleId String?      @map("transfer_fee_rule_id") @db.Uuid
  transferFeePaise  BigInt       @default(0) @map("transfer_fee_paise")
  carryForwardPaise BigInt       @map("carry_forward_paise")
