generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ───────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                     User[]
  roles                     Role[]
  config                    CompanyConfig?
  customFieldDefs           CustomFieldDefinition[]
  auditLogs                 AuditLog[]
  inquirySources            InquirySource[]
  inquiryTypes              InquiryType[]
  followUpTypes             FollowUpType[]
  communicationTypes        CommunicationType[]
  areaLocations             AreaLocation[]
  projectTypes              ProjectType[]
  documentTypes             DocumentType[]
  letterTemplates           LetterTemplate[]
  banks                     Bank[]
  receiptTypes              ReceiptType[]
  registrationTypes         RegistrationType[]
  chargeTypes               ChargeType[]
  gstRates                  GstRate[]
  tdsRules                  TdsRule[]
  interestRules             InterestRule[]
  transferFeeRules          TransferFeeRule[]
  paymentPlanTemplates      PaymentPlanTemplate[]
  unitTypes                 UnitType[]
  plcTypes                  PlcType[]
  projects                  Project[]
  towers                    Tower[]
  floors                    Floor[]
  units                     Unit[]
  unitPlcs                  UnitPlc[]
  unitCharges               UnitCharge[]
  unitRateRevisions         UnitRateRevision[]
  unitStatusChanges         UnitStatusChange[]
  applicants                Applicant[]
  applicantConsents         ApplicantConsent[]
  applicantMerges           ApplicantMerge[]
  applicantDistinctPairs    ApplicantDistinctPair[]
  inquiryTemperatures       InquiryTemperature[]
  leadStages                LeadStage[]
  dumpReasons               DumpReason[]
  inquiries                 Inquiry[]
  inquiryAssignments        InquiryAssignment[]
  inquiryStageHistory       InquiryStageHistory[]
  inquiryDispositionHistory InquiryDispositionHistory[]
  projectAssignmentPools    ProjectAssignmentPool[]
  followUps                 FollowUp[]
  smsTemplates              SmsTemplate[]
  communicationLogs         CommunicationLog[]
  cancellationRules         CancellationRule[]
  applicantAddresses        ApplicantAddress[]
  applicantDocuments        ApplicantDocument[]
  bookings                  Booking[]
  bookingCoApplicants       BookingCoApplicant[]
  bookingCostLines          BookingCostLine[]
  paymentPlans              PaymentPlan[]
  installments              Installment[]
  ledgerEntries             LedgerEntry[]
  receipts                  Receipt[]
  receiptAllocations        ReceiptAllocation[]
  chequeStatusEvents        ChequeStatusEvent[]
  numberSequences           NumberSequence[]
  transfers                 Transfer[]
  cancellations             Cancellation[]
  refunds                   Refund[]
  paymentVouchers           PaymentVoucher[]
  extraCharges              ExtraCharge[]
  tdsDeductions             TdsDeduction[]
  tdsCertificates           TdsCertificate[]
  interestAccruals          InterestAccrual[]
  paymentPlanMilestones     PaymentPlanMilestone[]
  generatedDocuments        GeneratedDocument[]
  documentDispatches        DocumentDispatch[]
  bookingDrafts             BookingDraft[]
  brokers                   Broker[]
  brokerBankDetails         BrokerBankDetail[]
  brokerCommissionRules     BrokerCommissionRule[]
  brokerCommissionSlabs     BrokerCommissionSlab[]
  brokerBookingCommissions  BrokerBookingCommission[]
  commissionLedgerEntries   CommissionLedgerEntry[]
  commissionPayments        CommissionPayment[]
  brokerNocs                BrokerNoc[]
  portalInvites             PortalInvite[]
  portalPasswordResets      PortalPasswordReset[]
  passwordResets            PasswordReset[]
  applicantChangeRequests   ApplicantChangeRequest[]
  ticketCategories          TicketCategory[]
  tickets                   Ticket[]
  ticketMessages            TicketMessage[]
  constructionUpdates       ConstructionUpdate[]
  constructionUpdateMedia   ConstructionUpdateMedia[]
  projectMedia              ProjectMedia[]
  pluginInstallations       PluginInstallation[]
  webhookEndpoints          WebhookEndpoint[]
  webhookDeliveries         WebhookDelivery[]
  webhookDeliveryAttempts   WebhookDeliveryAttempt[]
  leadSourceApiKeys         LeadSourceApiKey[]
  inventoryGroups           InventoryGroup[]
  stageRaises               StageRaise[]

  @@map("companies")
}

// ─── Auth ──────────────────────────────────────────────────────

model User {
  id                  String  @id @default(uuid()) @db.Uuid
  companyId           String  @map("company_id") @db.Uuid
  // Phase 6: nullable — a phone-only portal invite (Applicant.email is
  // optional) creates a User with email = null, never a synthesized
  // placeholder address. Staff creation still always supplies it.
  email               String? @db.VarChar(255)
  passwordHash        String  @map("password_hash") @db.VarChar(255)
  name                String  @db.VarChar(255)
  phone               String? @db.VarChar(20)
  roleId              String  @map("role_id") @db.Uuid
  isActive            Boolean @default(true) @map("is_active")
  forcePasswordChange Boolean @default(true) @map("force_password_change")
  // Manager hierarchy (v0.4): scalar FK + DB-level constraint, not a Prisma
  // relation — same "no back-relation bloat on User" policy as every other
  // User-linked FK (Phase 4 decisions). Cycle-checked at the service layer
  // on write (TeamScopeService's recursive CTE has no cycle protection of
  // its own — see UsersService.assertValidManager). Manager name for
  // display is resolved by a separate lookup, not an `include`.
  managerId           String? @map("manager_id") @db.Uuid

  totpSecret    String?  @map("totp_secret") @db.VarChar(255)
  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  recoveryCodes String[] @map("recovery_codes")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  // Phase 6: portal identity. Scalar + DB-level FK, no Prisma relation
  // (Relation policy — same shape as Booking.interestRuleId). A portal
  // User has EXACTLY ONE of these set (service-layer invariant, not a
  // DB CHECK); both are null for every staff User, as today.
  applicantId       String? @map("applicant_id") @db.Uuid
  brokerId          String? @map("broker_id") @db.Uuid
  // Phase 6: per-user notification opt-in/out, small non-relational
  // blob — matches CompanyConfig.labelOverrides's JSON-column precedent.
  // Only portal users populate it.
  notificationPrefs Json?   @map("notification_prefs")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                       Company                     @relation(fields: [companyId], references: [id])
  role                          Role                        @relation(fields: [roleId], references: [id])
  refreshTokens                 RefreshToken[]
  auditLogs                     AuditLog[]
  rateRevisionsCreated          UnitRateRevision[]          @relation("rateRevisionCreator")
  statusChangesActed            UnitStatusChange[]          @relation("statusChangeActor")
  consentsRecorded              ApplicantConsent[]          @relation("consentActor")
  applicantMergesActed          ApplicantMerge[]            @relation("applicantMergeActor")
  applicantDistinctPairsDecided ApplicantDistinctPair[]     @relation("applicantDistinctPairDecider")
  inquiriesAssigned             Inquiry[]                   @relation("inquiryAssignee")
  inquiriesCreated              Inquiry[]                   @relation("inquiryCreator")
  assignmentsFrom               InquiryAssignment[]         @relation("assignmentFrom")
  assignmentsTo                 InquiryAssignment[]         @relation("assignmentTo")
  assignmentsActed              InquiryAssignment[]         @relation("assignmentActor")
  stageChangesActed             InquiryStageHistory[]       @relation("stageHistoryChangedBy")
  dispositionChangesActed       InquiryDispositionHistory[] @relation("dispositionHistoryChangedBy")
  assignmentPools               ProjectAssignmentPool[]     @relation("assignmentPoolMember")
  followUpsCreated              FollowUp[]                  @relation("followUpCreator")
  communicationLogsCreated      CommunicationLog[]          @relation("commLogCreator")

  @@unique([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, managerId])
  @@map("users")
}

/// Admin-triggered password reset for a STAFF user (portal-user targets
/// reuse the existing PortalPasswordReset flow instead — see
/// UsersService.forcePasswordReset). Same hashed/single-use/expiring
/// shape as PortalPasswordReset; createdById records which admin
/// triggered it. Rows are created synchronously by the request handler
/// (unlike PortalPasswordReset's async processor) — no identifier lookup
/// happens here, so there's no timing-equality concern to protect.
model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([tokenHash])
  @@map("password_resets")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  family    String    @db.Uuid
  isRevoked Boolean   @default(false) @map("is_revoked")
  /// When isRevoked flipped true. Phase 1 deliberately used a bare boolean
  /// ("simpler queries, same semantics") — that held until reuse detection
  /// had to tell a benign re-presentation from a genuine replay, which is
  /// purely a question of HOW LONG AGO the token was consumed. Nullable:
  /// rows revoked before this column existed have no timestamp and are
  /// therefore treated as outside any grace window, which is the safe
  /// default (they take the existing revoke-the-family path).
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([family])
  @@index([userId])
  /// Serves the grace-window lookup ("the live token in this family") that
  /// rotateRefreshToken runs on every re-presented token.
  @@index([family, isRevoked])
  @@map("refresh_tokens")
}

// ─── RBAC ──────────────────────────────────────────────────────

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(100)
  isSystem  Boolean  @default(false) @map("is_system")
  isPortal  Boolean  @default(false) @map("is_portal")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, slug])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(100)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Audit ─────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  action     String   @db.VarChar(20)
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ─── Custom Fields ─────────────────────────────────────────────

model CustomFieldDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(100)
  key          String   @db.VarChar(100)
  label        String   @db.VarChar(255)
  fieldType    String   @map("field_type") @db.VarChar(20)
  options      Json?
  defaultValue String?  @map("default_value") @db.VarChar(500)
  isRequired   Boolean  @default(false) @map("is_required")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, entityType, key])
  @@map("custom_field_definitions")
}

// ─── Company Config ────────────────────────────────────────────

model CompanyConfig {
  companyId                  String    @id @map("company_id") @db.Uuid
  labelOverrides             Json      @default("{}") @map("label_overrides")
  enabledModules             Json      @default("[\"presales\",\"postsales\",\"accounts\"]") @map("enabled_modules")
  currency                   String    @default("INR") @db.VarChar(3)
  timezone                   String    @default("Asia/Kolkata") @db.VarChar(50)
  fyStartMonth               Int       @default(4) @map("fy_start_month")
  dateFormat                 String    @default("DD-MM-YYYY") @map("date_format") @db.VarChar(20)
  // Supplier-side GST identity — source of truth for the CGST/SGST-vs-IGST
  // split (Phase 4). gstStateCode is the 2-char GST state code (e.g. "09"
  // for UP, "27" for Maharashtra); the first two chars of a GSTIN.
  companyGstin               String?   @map("company_gstin") @db.VarChar(15)
  gstStateCode               String?   @map("gst_state_code") @db.VarChar(2)
  // Flat charge (paise) applied when a cheque bounces (Phase 4). A receipt
  // or refund cheque bounce posts a BOUNCE_CHARGE debit of this amount.
  chequeBounceChargePaise    BigInt    @default(0) @map("cheque_bounce_charge_paise")
  // Phase 5: which event triggers broker-commission accrual — ON_BOOKING
  // (full commission at booking confirmation) or ON_COLLECTION_MILESTONE
  // (partitioned across configured collection-percent breakpoints).
  commissionAccrualTrigger   String    @default("ON_BOOKING") @map("commission_accrual_trigger") @db.VarChar(30)
  // Phase 5: what happens to ALREADY-PAID commission when its booking is
  // cancelled — RECOVER (post a CLAWBACK_RECOVERY debit, broker owes it
  // back) or WRITE_OFF (company forgives it; a zero-amount audited entry
  // records the decision, reason required).
  commissionClawbackPolicy   String    @default("RECOVER") @map("commission_clawback_policy") @db.VarChar(20)
  // Phase 6: portal branding (logo + accent color shown in apps/portal).
  logoUrl                    String?   @map("logo_url") @db.VarChar(500)
  primaryColorHex            String?   @map("primary_color_hex") @db.VarChar(7)
  // v0.2.2: shared cap for ProjectMedia + ConstructionUpdateMedia — both
  // roll up disk usage under one project, an unbounded self-hosted
  // install fills its disk regardless of which table the row lands in.
  // Configurable, sensible defaults (50 files / 500MB per project).
  projectMediaMaxFiles       Int       @default(50) @map("project_media_max_files")
  projectMediaMaxBytes       Int       @default(524288000) @map("project_media_max_bytes")
  // A rep's own inquiry must never silently move to someone else via
  // round-robin. When true (default), InquiryService.create() assigns an
  // interactively-created inquiry straight to its creator; round-robin only
  // ever runs for machine-driven intake (inbound lead API, bulk import),
  // which has no human creator to retain ownership for.
  presalesCreatorRetainsLead Boolean   @default(true) @map("presales_creator_retains_lead")
  // v0.5: automated intake (inbound lead API, bulk import) has no human
  // present to ask "same person or not" — when true (default, unchanged
  // behavior), a phone/email match auto-links to the existing applicant.
  // A company with heavy legitimate phone-sharing (family members, a
  // broker's office line) can flip this to always create a NEW applicant
  // and flag the match for a human to resolve later instead, via
  // ApplicantDistinctPair — never silently guessing which is riskier here.
  presalesPhoneDedupAutoLink Boolean   @default(true) @map("presales_phone_dedup_auto_link")
  // One-time marker, not an inferred-from-row-count check: "zero
  // LeadStage rows" is ambiguous between "never seeded" and "admin
  // deleted all six after a real seeding" — inferring from count alone
  // would resurrect a deliberate deletion on the next upgrade, the
  // exact class of bug this project has already been burned by for
  // seeded masters. Set once, in the same transaction as the initial
  // 6-row seed (fresh install via seed.ts, or an existing install via
  // sync-permissions.ts's syncLeadStages on upgrade); never touched
  // again afterward, so a company that deletes its stages stays deleted.
  leadStagesSeededAt         DateTime? @map("lead_stages_seeded_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_configs")
}

// ─── Masters: simple lookups ───────────────────────────────────

model InquirySource {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("inquiry_sources")
}

model InquiryType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("inquiry_types")
}

model FollowUpType {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  name      String     @db.VarChar(255)
  isActive  Boolean    @default(true) @map("is_active")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  company   Company    @relation(fields: [companyId], references: [id])
  followUps FollowUp[]

  @@unique([companyId, name])
  @@map("follow_up_types")
}

model CommunicationType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("communication_types")
}

model ProjectType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  projects  Project[]

  @@unique([companyId, name])
  @@map("project_types")
}

model ReceiptType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("receipt_types")
}

model RegistrationType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("registration_types")
}

// ─── Masters: with extra fields ────────────────────────────────

model AreaLocation {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  city      String?   @db.VarChar(100)
  state     String?   @db.VarChar(100)
  // GST state code of the property location — the default place-of-supply
  // for bookings on projects in this area (IGST Act §12(3)(a), Phase 4).
  stateCode String?   @map("state_code") @db.VarChar(2)
  pincode   String?   @db.VarChar(10)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  projects  Project[]

  @@unique([companyId, name])
  @@map("area_locations")
}

model DocumentType {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("document_types")
}

model LetterTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(255)
  subject    String   @db.VarChar(500)
  body       String   @db.Text
  entityType String   @map("entity_type") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("letter_templates")
}

model Bank {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(255)
  ifscPrefix String?  @map("ifsc_prefix") @db.VarChar(11)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("banks")
}

model ChargeType {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  name        String       @db.VarChar(255)
  hsnSac      String?      @map("hsn_sac") @db.VarChar(20)
  gstRateId   String?      @map("gst_rate_id") @db.Uuid
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  company     Company      @relation(fields: [companyId], references: [id])
  gstRate     GstRate?     @relation(fields: [gstRateId], references: [id])
  unitCharges UnitCharge[]

  @@unique([companyId, name])
  @@map("charge_types")
}

model GstRate {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
