}

enum InquiryStatus {
  OPEN
  CONTINUED
  DUMPED
  SUCCESSFUL
}

model Inquiry {
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  applicantId         String        @map("applicant_id") @db.Uuid
  projectId           String?       @map("project_id") @db.Uuid
  sourceId            String?       @map("source_id") @db.Uuid
  inquiryTypeId       String?       @map("inquiry_type_id") @db.Uuid
  budgetMinPaise      BigInt?       @map("budget_min_paise")
  budgetMaxPaise      BigInt?       @map("budget_max_paise")
  preferredUnitTypeId String?       @map("preferred_unit_type_id") @db.Uuid
  temperatureId       String?       @map("temperature_id") @db.Uuid
  assignedToId        String?       @map("assigned_to_id") @db.Uuid
  status              InquiryStatus @default(OPEN)
  nextFollowupAt      DateTime?     @map("next_followup_at")
  lastEscalatedAt     DateTime?     @map("last_escalated_at")
