generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ───────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                  User[]
  roles                  Role[]
  config                 CompanyConfig?
  customFieldDefs        CustomFieldDefinition[]
  auditLogs              AuditLog[]
  inquirySources         InquirySource[]
  inquiryTypes           InquiryType[]
  followUpTypes          FollowUpType[]
  communicationTypes     CommunicationType[]
  areaLocations          AreaLocation[]
  projectTypes           ProjectType[]
  documentTypes          DocumentType[]
  letterTemplates        LetterTemplate[]
  banks                  Bank[]
  receiptTypes           ReceiptType[]
  registrationTypes      RegistrationType[]
  chargeTypes            ChargeType[]
  gstRates               GstRate[]
  tdsRules               TdsRule[]
  interestRules          InterestRule[]
  transferFeeRules       TransferFeeRule[]
  paymentPlanTemplates   PaymentPlanTemplate[]
  unitTypes              UnitType[]
  plcTypes               PlcType[]
  projects               Project[]
  towers                 Tower[]
  floors                 Floor[]
  units                  Unit[]
  unitPlcs               UnitPlc[]
  unitCharges            UnitCharge[]
  unitRateRevisions      UnitRateRevision[]
  unitStatusChanges      UnitStatusChange[]
  applicants             Applicant[]
  applicantConsents      ApplicantConsent[]
  applicantMerges        ApplicantMerge[]
  inquiryTemperatures    InquiryTemperature[]
  inquiries              Inquiry[]
  inquiryAssignments     InquiryAssignment[]
  projectAssignmentPools ProjectAssignmentPool[]
  followUps              FollowUp[]
  smsTemplates           SmsTemplate[]
  communicationLogs      CommunicationLog[]

  @@map("companies")
}

// ─── Auth ──────────────────────────────────────────────────────

model User {
  id                  String  @id @default(uuid()) @db.Uuid
  companyId           String  @map("company_id") @db.Uuid
  email               String  @db.VarChar(255)
  passwordHash        String  @map("password_hash") @db.VarChar(255)
  name                String  @db.VarChar(255)
  phone               String? @db.VarChar(20)
  roleId              String  @map("role_id") @db.Uuid
  isActive            Boolean @default(true) @map("is_active")
  forcePasswordChange Boolean @default(true) @map("force_password_change")

  totpSecret    String?  @map("totp_secret") @db.VarChar(255)
  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  recoveryCodes String[] @map("recovery_codes")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                  Company                 @relation(fields: [companyId], references: [id])
  role                     Role                    @relation(fields: [roleId], references: [id])
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  rateRevisionsCreated     UnitRateRevision[]      @relation("rateRevisionCreator")
  statusChangesActed       UnitStatusChange[]      @relation("statusChangeActor")
  consentsRecorded         ApplicantConsent[]      @relation("consentActor")
  applicantMergesActed     ApplicantMerge[]        @relation("applicantMergeActor")
  inquiriesAssigned        Inquiry[]               @relation("inquiryAssignee")
  assignmentsFrom          InquiryAssignment[]     @relation("assignmentFrom")
  assignmentsTo            InquiryAssignment[]     @relation("assignmentTo")
  assignmentsActed         InquiryAssignment[]     @relation("assignmentActor")
  assignmentPools          ProjectAssignmentPool[] @relation("assignmentPoolMember")
  followUpsCreated         FollowUp[]              @relation("followUpCreator")
  communicationLogsCreated CommunicationLog[]      @relation("commLogCreator")

  @@unique([companyId, email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(64)
  family    String   @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([family])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── RBAC ──────────────────────────────────────────────────────

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(100)
  isSystem  Boolean  @default(false) @map("is_system")
  isPortal  Boolean  @default(false) @map("is_portal")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, slug])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(100)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Audit ─────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  action     String   @db.VarChar(20)
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ─── Custom Fields ─────────────────────────────────────────────

model CustomFieldDefinition {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  key        String   @db.VarChar(100)
  label      String   @db.VarChar(255)
  fieldType  String   @map("field_type") @db.VarChar(20)
  options    Json?
  isRequired Boolean  @default(false) @map("is_required")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, entityType, key])
  @@map("custom_field_definitions")
}

// ─── Company Config ────────────────────────────────────────────

model CompanyConfig {
  companyId      String   @id @map("company_id") @db.Uuid
  labelOverrides Json     @default("{}") @map("label_overrides")
  enabledModules Json     @default("[\"presales\",\"postsales\",\"accounts\"]") @map("enabled_modules")
  currency       String   @default("INR") @db.VarChar(3)
  timezone       String   @default("Asia/Kolkata") @db.VarChar(50)
  fyStartMonth   Int      @default(4) @map("fy_start_month")
  dateFormat     String   @default("DD-MM-YYYY") @map("date_format") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_configs")
}

// ─── Masters: simple lookups ───────────────────────────────────

model InquirySource {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("inquiry_sources")
}

model InquiryType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("inquiry_types")
}

model FollowUpType {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  name      String     @db.VarChar(255)
  isActive  Boolean    @default(true) @map("is_active")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  company   Company    @relation(fields: [companyId], references: [id])
  followUps FollowUp[]

  @@unique([companyId, name])
  @@map("follow_up_types")
}

model CommunicationType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("communication_types")
}

model ProjectType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  projects  Project[]

  @@unique([companyId, name])
  @@map("project_types")
}

model ReceiptType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("receipt_types")
}

model RegistrationType {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("registration_types")
}

// ─── Masters: with extra fields ────────────────────────────────

model AreaLocation {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  city      String?   @db.VarChar(100)
  state     String?   @db.VarChar(100)
  pincode   String?   @db.VarChar(10)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  projects  Project[]

  @@unique([companyId, name])
  @@map("area_locations")
}

model DocumentType {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("document_types")
}

model LetterTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(255)
  subject    String   @db.VarChar(500)
  body       String   @db.Text
  entityType String   @map("entity_type") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("letter_templates")
}

model Bank {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(255)
  ifscPrefix String?  @map("ifsc_prefix") @db.VarChar(11)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("banks")
}

model ChargeType {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  name        String       @db.VarChar(255)
  hsnSac      String?      @map("hsn_sac") @db.VarChar(20)
  gstRateId   String?      @map("gst_rate_id") @db.Uuid
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  company     Company      @relation(fields: [companyId], references: [id])
  gstRate     GstRate?     @relation(fields: [gstRateId], references: [id])
  unitCharges UnitCharge[]

  @@unique([companyId, name])
  @@map("charge_types")
}

model GstRate {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  rate          Decimal      @db.Decimal(5, 2)
  description   String       @db.VarChar(255)
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  isActive      Boolean      @default(true) @map("is_active")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  company       Company      @relation(fields: [companyId], references: [id])
  chargeTypes   ChargeType[]

  @@map("gst_rates")
}

model TdsRule {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  section        String    @db.VarChar(20)
  ratePercent    Decimal   @map("rate_percent") @db.Decimal(5, 2)
  thresholdPaise BigInt    @map("threshold_paise")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  description    String?   @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  company        Company   @relation(fields: [companyId], references: [id])

  @@map("tds_rules")
}

model InterestRule {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(255)
  rateType    String   @map("rate_type") @db.VarChar(20)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  frequency   String   @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("interest_rules")
}

model TransferFeeRule {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(255)
  feeType     String   @map("fee_type") @db.VarChar(20)
  amountPaise BigInt?  @map("amount_paise")
  percentage  Decimal? @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("transfer_fee_rules")
}

model PaymentPlanTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("payment_plan_templates")
}

// ─── Phase 2: Inventory ───────────────────────────────────────

enum UnitStatus {
  AVAILABLE
  HELD
  BLOCKED
  BOOKED
  ALLOTTED
  REGISTERED
  CANCELLED
}

model UnitType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  units     Unit[]
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("unit_types")
}

model PlcType {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  unitPlcs  UnitPlc[]

  @@unique([companyId, name])
  @@map("plc_types")
}

model Project {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  name            String    @db.VarChar(255)
  code            String    @db.VarChar(50)
  projectTypeId   String?   @map("project_type_id") @db.Uuid
  reraNumber      String?   @map("rera_number") @db.VarChar(100)
  areaLocationId  String?   @map("area_location_id") @db.Uuid
  address         String?   @db.Text
  description     String?   @db.Text
  startDate       DateTime? @map("start_date") @db.Date
  expectedEndDate DateTime? @map("expected_end_date") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company         Company                 @relation(fields: [companyId], references: [id])
  projectType     ProjectType?            @relation(fields: [projectTypeId], references: [id])
  areaLocation    AreaLocation?           @relation(fields: [areaLocationId], references: [id])
  towers          Tower[]
  inquiries       Inquiry[]
  assignmentPools ProjectAssignmentPool[]

  @@unique([companyId, code])
  @@map("projects")
}

model Tower {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String   @db.VarChar(255)
  code        String   @db.VarChar(50)
  totalFloors Int      @default(0) @map("total_floors")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  floors  Floor[]

  @@unique([projectId, code])
  @@map("towers")
}

model Floor {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  towerId     String   @map("tower_id") @db.Uuid
  name        String   @db.VarChar(100)
  floorNumber Int      @map("floor_number")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  tower   Tower   @relation(fields: [towerId], references: [id])
  units   Unit[]

  @@unique([towerId, floorNumber])
  @@map("floors")
}

model Unit {
  id               String     @id @default(uuid()) @db.Uuid
  companyId        String     @map("company_id") @db.Uuid
  floorId          String     @map("floor_id") @db.Uuid
  unitTypeId       String?    @map("unit_type_id") @db.Uuid
  number           String     @db.VarChar(50)
  status           UnitStatus @default(AVAILABLE)
  carpetAreaSqft   Decimal?   @map("carpet_area_sqft") @db.Decimal(10, 2)
  builtUpAreaSqft  Decimal?   @map("built_up_area_sqft") @db.Decimal(10, 2)
  superBuiltUpSqft Decimal?   @map("super_built_up_sqft") @db.Decimal(10, 2)
  baseRatePaise    BigInt     @default(0) @map("base_rate_paise")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyId], references: [id])
  floor         Floor              @relation(fields: [floorId], references: [id])
  unitType      UnitType?          @relation(fields: [unitTypeId], references: [id])
  plcs          UnitPlc[]
  charges       UnitCharge[]
  rateRevisions UnitRateRevision[]
  statusChanges UnitStatusChange[]

  @@unique([floorId, number])
  @@map("units")
}

model UnitPlc {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  plcTypeId   String   @map("plc_type_id") @db.Uuid
  amountPaise BigInt   @map("amount_paise")
  percentage  Decimal? @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  plcType PlcType @relation(fields: [plcTypeId], references: [id])

  @@unique([unitId, plcTypeId])
  @@map("unit_plcs")
}

model UnitCharge {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  chargeTypeId String   @map("charge_type_id") @db.Uuid
  amountPaise  BigInt   @map("amount_paise")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeId], references: [id])

  @@unique([unitId, chargeTypeId])
  @@map("unit_charges")
}

model UnitRateRevision {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  unitId        String   @map("unit_id") @db.Uuid
  ratePaise     BigInt   @map("rate_paise")
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String?  @db.VarChar(500)
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("rateRevisionCreator", fields: [createdById], references: [id])

  @@unique([unitId, effectiveFrom])
  @@map("unit_rate_revisions")
}

model UnitStatusChange {
  id         String     @id @default(uuid()) @db.Uuid
  companyId  String     @map("company_id") @db.Uuid
  unitId     String     @map("unit_id") @db.Uuid
  fromStatus UnitStatus @map("from_status")
  toStatus   UnitStatus @map("to_status")
  reason     String?    @db.VarChar(500)
  actorType  String     @map("actor_type") @db.VarChar(20)
  actorId    String?    @map("actor_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actor   User?   @relation("statusChangeActor", fields: [actorId], references: [id])

  @@index([unitId, createdAt])
  @@map("unit_status_changes")
}

// ─── Phase 3: Pre-sales — inquiries, assignment, follow-ups ───

model Applicant {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  name                   String   @db.VarChar(255)
  primaryPhone           String   @map("primary_phone") @db.VarChar(20)
  primaryPhoneNormalized String   @map("primary_phone_normalized") @db.VarChar(20)
  alternatePhones        String[] @map("alternate_phones")
  email                  String?  @db.VarChar(255)
  emailNormalized        String?  @map("email_normalized") @db.VarChar(255)
  addressLine1           String?  @map("address_line1") @db.VarChar(255)
  city                   String?  @db.VarChar(100)
  state                  String?  @db.VarChar(100)
  pincode                String?  @db.VarChar(10)
  customFields           Json?    @map("custom_fields")
  mergedIntoId           String?  @map("merged_into_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id])
  mergedInto        Applicant?         @relation("applicantMergeChain", fields: [mergedIntoId], references: [id])
  mergedFrom        Applicant[]        @relation("applicantMergeChain")
  consents          ApplicantConsent[]
  survivorOfMerges  ApplicantMerge[]   @relation("mergeSurvivor")
  absorbedInMerge   ApplicantMerge?    @relation("mergeAbsorbed")
  inquiries         Inquiry[]
  communicationLogs CommunicationLog[]

  @@index([companyId, primaryPhoneNormalized])
  @@index([companyId, emailNormalized])
  @@map("applicants")
}

/// Append-only consent ledger. Current consent = latest row per applicant.
/// Never updated or deleted — revoking/re-granting inserts a new row.
model ApplicantConsent {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  given       Boolean
  source      String?  @map("source") @db.VarChar(100)
  actorId     String?  @map("actor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  actor     User?     @relation("consentActor", fields: [actorId], references: [id])

  @@index([applicantId, createdAt])
  @@map("applicant_consents")
}

model ApplicantMerge {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  survivorId String   @map("survivor_id") @db.Uuid
  mergedId   String   @unique @map("merged_id") @db.Uuid
  mergedById String?  @map("merged_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  survivor Applicant @relation("mergeSurvivor", fields: [survivorId], references: [id])
  merged   Applicant @relation("mergeAbsorbed", fields: [mergedId], references: [id])
  mergedBy User?     @relation("applicantMergeActor", fields: [mergedById], references: [id])

  @@map("applicant_merges")
}

model InquiryTemperature {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])
  inquiries Inquiry[]

  @@unique([companyId, name])
  @@map("inquiry_temperatures")
}

enum InquiryStatus {
  OPEN
  CONTINUED
  DUMPED
  SUCCESSFUL
}

model Inquiry {
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  applicantId         String        @map("applicant_id") @db.Uuid
  projectId           String?       @map("project_id") @db.Uuid
  sourceId            String?       @map("source_id") @db.Uuid
  inquiryTypeId       String?       @map("inquiry_type_id") @db.Uuid
  budgetMinPaise      BigInt?       @map("budget_min_paise")
  budgetMaxPaise      BigInt?       @map("budget_max_paise")
  preferredUnitTypeId String?       @map("preferred_unit_type_id") @db.Uuid
  temperatureId       String?       @map("temperature_id") @db.Uuid
  assignedToId        String?       @map("assigned_to_id") @db.Uuid
  status              InquiryStatus @default(OPEN)
  nextFollowupAt      DateTime?     @map("next_followup_at")
  lastEscalatedAt     DateTime?     @map("last_escalated_at")
  customFields        Json?         @map("custom_fields")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  company           Company             @relation(fields: [companyId], references: [id])
  applicant         Applicant           @relation(fields: [applicantId], references: [id])
  project           Project?            @relation(fields: [projectId], references: [id])
  source            InquirySource?      @relation(fields: [sourceId], references: [id])
  inquiryType       InquiryType?        @relation(fields: [inquiryTypeId], references: [id])
  preferredUnitType UnitType?           @relation(fields: [preferredUnitTypeId], references: [id])
  temperature       InquiryTemperature? @relation(fields: [temperatureId], references: [id])
  assignedTo        User?               @relation("inquiryAssignee", fields: [assignedToId], references: [id])
  followUps         FollowUp[]
  assignments       InquiryAssignment[]
  communicationLogs CommunicationLog[]

  @@index([companyId, assignedToId, status])
  @@index([companyId, nextFollowupAt])
  @@index([companyId, status, createdAt])
  @@map("inquiries")
}

model InquiryAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  inquiryId      String   @map("inquiry_id") @db.Uuid
  fromUserId     String?  @map("from_user_id") @db.Uuid
  toUserId       String   @map("to_user_id") @db.Uuid
  assignmentType String   @map("assignment_type") @db.VarChar(20)
  actorId        String?  @map("actor_id") @db.Uuid
  reason         String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  company  Company @relation(fields: [companyId], references: [id])
  inquiry  Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromUser User?   @relation("assignmentFrom", fields: [fromUserId], references: [id])
  toUser   User    @relation("assignmentTo", fields: [toUserId], references: [id])
  actor    User?   @relation("assignmentActor", fields: [actorId], references: [id])

  @@index([inquiryId, createdAt])
  @@map("inquiry_assignments")
}

model ProjectAssignmentPool {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  pausedReason   String?   @map("paused_reason") @db.VarChar(100)
  lastAssignedAt DateTime? @map("last_assigned_at") @db.Timestamp(6)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("assignmentPoolMember", fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([companyId, projectId, isActive])
  @@map("project_assignment_pools")
}

enum FollowUpOutcome {
  COMPLETED
  NO_RESPONSE
  RESCHEDULED
  NOT_INTERESTED
  CONVERTED
}

model FollowUp {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  inquiryId    String           @map("inquiry_id") @db.Uuid
  typeId       String?          @map("follow_up_type_id") @db.Uuid
  notes        String?          @db.Text
  outcome      FollowUpOutcome?
  nextActionAt DateTime?        @map("next_action_at")
  scheduledAt  DateTime?        @map("scheduled_at")
  venue        String?          @db.VarChar(255)
  createdById  String?          @map("created_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  company   Company       @relation(fields: [companyId], references: [id])
  inquiry   Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type      FollowUpType? @relation(fields: [typeId], references: [id])
  createdBy User?         @relation("followUpCreator", fields: [createdById], references: [id])

  @@index([companyId, inquiryId, createdAt])
  @@index([companyId, nextActionAt])
  @@map("follow_ups")
}

model SmsTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String   @db.VarChar(255)
  dltTemplateId String   @map("dlt_template_id") @db.VarChar(50)
  senderId      String   @map("sender_id") @db.VarChar(11)
  headerId      String?  @map("header_id") @db.VarChar(50)
  body          String   @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  company       Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@map("sms_templates")
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationStatus {
  QUEUED
  SENT
  FAILED
}

/// Append-only send ledger. applicantId is NEVER reassigned on applicant
/// merge — it always identifies the original recipient of the message,
/// even if that applicant is later merged into a survivor (see CLAUDE.md
/// Phase 3 decisions).
model CommunicationLog {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  inquiryId         String?              @map("inquiry_id") @db.Uuid
  applicantId       String               @map("applicant_id") @db.Uuid
  channel           CommunicationChannel
  toAddress         String               @map("to_address") @db.VarChar(255)
  subject           String?              @db.VarChar(500)
  body              String               @db.Text
  status            CommunicationStatus  @default(QUEUED)
  providerMessageId String?              @map("provider_message_id") @db.VarChar(255)
  errorMessage      String?              @map("error_message") @db.Text
  sentAt            DateTime?            @map("sent_at")
  createdById       String?              @map("created_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  inquiry   Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  applicant Applicant @relation(fields: [applicantId], references: [id])
  createdBy User?     @relation("commLogCreator", fields: [createdById], references: [id])

  @@index([companyId, applicantId, createdAt])
  @@map("communication_logs")
}
