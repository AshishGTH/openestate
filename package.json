{
  "name": "openestate",
  "private": true,
  "version": "0.1.2",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter @openestate/db run seed",
    "seed:demo": "pnpm --filter @openestate/db run seed:demo",
    "seed:portal-demo": "pnpm --filter @openestate/api run seed:portal-demo"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0"
  }
}
